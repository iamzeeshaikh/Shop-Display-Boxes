---
import { withExtras, extraFaqs, extraHeading } from '../../lib/page-faqs';
import FaqAccordion from '../../components/FaqAccordion.astro';
/**
 * Location hub — the only site-wide entry point to location pages.
 *
 * Location links deliberately do NOT appear in the footer or in the primary
 * navigation. Repeating 24 location links on every page is the keyword-stuffed
 * pattern the brief rules out, and it would dilute the internal linking that
 * the product and commercial pages depend on.
 *
 * The hub is organized state → cities, so the parent/child relationship is
 * visible to a reader and to a crawler without generating parameter URLs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PUBLISHED_STATES, PUBLISHED_CITIES } from '../../data/locations';
import { graph, webPage, breadcrumbs as breadcrumbSchema, type Crumb, faqPage } from '../../lib/schema';

const url = '/locations/';
const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url },
];

const seo = {
  url,
  title: 'Locations We Ship Custom Display Packaging To | USA',
  description:
    'The states and cities we ship custom display packaging to, with the sector context that shapes packaging choices in each.',
};

const schema = graph(
  webPage({ url, name: 'Locations we ship to', description: seo.description, type: 'CollectionPage' }),
  breadcrumbSchema(crumbs),
  extraFaqs(Astro.url.pathname).length ? faqPage(extraFaqs(Astro.url.pathname)) : null
);

const statesWithCities = PUBLISHED_STATES.filter((s) => s.cities.length > 0);
const statesWithoutCities = PUBLISHED_STATES.filter((s) => s.cities.length === 0);
---

<BaseLayout {...seo} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="lo-head">
    <h1>Where we ship custom display packaging</h1>
    <p>
      We ship free to business addresses across the United States, and to the UK, Canada and Australia. The pages below cover the sectors
      and retail conditions in particular markets — because what drives a packaging decision in a
      freight hub is genuinely different from what drives one in a high-rent retail city.
    </p>
  </section>

  <section class="band--tight wrap">
    <div class="lo-note">
      <h2>What these pages are, and are not</h2>
      <p>
        They are context, not a branch network. Our registered address is in Brooklyn, New York —
        that is the one place we are actually based, and it is not a published trade counter you
        can collect from. Everywhere else on this list, we have no office, facility, warehouse, or
        collection point, and every order is produced to specification and shipped to you.
      </p>
      <p>
        We publish a location page only where there is something genuinely specific to say about
        that market. Adding pages for every state to look bigger would mean writing the same page
        fifty times with the name changed, which helps nobody.
      </p>
    </div>
  </section>

  <section class="band wrap">
    <h2 class="lo-h">States</h2>
    <ul class="lo-states">
      {
        statesWithCities.map((state) => (
          <li class="lo-state">
            <a class="lo-state__link" href={`/${state.slug}/`}>
              <span class="lo-state__name">{state.name}</span>
              <span class="lo-state__abbr">{state.abbr}</span>
            </a>
            <p class="lo-state__note">{state.positioning}</p>
            <ul class="lo-state__cities">
              {state.cities.map((c) => (
                <li>
                  <a href={`/${c.slug}/`}>{c.name}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
      {
        statesWithoutCities.map((state) => (
          <li class="lo-state">
            <a class="lo-state__link" href={`/${state.slug}/`}>
              <span class="lo-state__name">{state.name}</span>
              <span class="lo-state__abbr">{state.abbr}</span>
            </a>
            <p class="lo-state__note">{state.positioning}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band band--mist wrap">
    <h2 class="lo-h">Cities</h2>
    <ul class="lo-cities">
      {
        PUBLISHED_CITIES.map((city) => (
          <li>
            <a href={`/${city.slug}/`}>
              <span>
                {city.name}, {city.stateAbbr}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band wrap">
    <div class="lo-cta">
      <div>
        <h2>Not listed here?</h2>
        <p>
          It makes no difference to your order. We ship to business addresses in every state, and
          the process is identical wherever you are — send the product and a quantity, and the
          dieline follows before you commit to anything.
        </p>
      </div>
      <a class="btn btn-solid btn-lg" href="/request-a-quote/">Request a quote</a>
    </div>
  </section>
  {extraFaqs(Astro.url.pathname).length > 0 && (
    <section class="band wrap">
      <FaqAccordion faqs={extraFaqs(Astro.url.pathname)} heading={extraHeading(Astro.url.pathname)} />
    </section>
  )}
</BaseLayout>

<style>
  .lo-head {
    padding: clamp(40px, 5vw, 72px) var(--gut);
    background: var(--ink);
  }
  .lo-head h1 {
    color: #fff;
  }
  .lo-head p {
    margin-block-start: 16px;
    max-width: 70ch;
    color: #d3deea;
    font-size: 1.125rem;
  }
  .lo-note {
    padding: clamp(24px, 3vw, 36px);
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    display: grid;
    gap: 14px 56px;
  }
  @media (min-width: 62em) {
    .lo-note {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .lo-note h2 {
    font-size: var(--t-xl);
  }
  .lo-note p {
    color: var(--ink-2);
  }
  .lo-h {
    margin-block-end: 20px;
  }
  .lo-states {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .lo-state {
    padding: 22px;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }
  .lo-state__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
  }
  .lo-state__name {
    font: 800 1.25rem/1.3 var(--font-display);
    color: var(--ink);
  }
  .lo-state__link:hover .lo-state__name {
    color: var(--cobalt);
  }
  .lo-state__abbr {
    font-weight: 700;
    color: var(--cobalt);
  }
  .lo-state__note {
    margin-block-start: 8px;
    color: var(--muted);
    font-size: 15px;
  }
  .lo-state__cities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    list-style: none;
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-block-start: 1px solid var(--rule);
    font-weight: 600;
    font-size: 15px;
  }
  .lo-cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
  }
  .lo-cities a {
    display: block;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 10px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .lo-cities a:hover {
    border-color: var(--cobalt);
    color: var(--cobalt);
  }
  .lo-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(28px, 4vw, 48px);
    background: var(--ink);
    color: #c4d1e0;
    border-radius: var(--r-lg);
  }
  .lo-cta h2 {
    color: #fff;
    margin-block-end: 10px;
  }
  .lo-cta p {
    max-width: 62ch;
  }
</style>
