---
/**
 * Confirmation page shown after any form is submitted successfully.
 *
 * All forms (inquiry, short quote, full quote) redirect here on success. The
 * path is in NOINDEX_PATHS, so it is served noindex,follow and kept out of the
 * sitemap — a thank-you page has no business ranking.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURED_PRODUCTS } from '../data/products';
---

<BaseLayout
  url="/thank-you/"
  title="Thank You — We’ve Received Your Message | Shop Display Boxes"
  description="Your message has been received. We usually reply the same working day with next steps."
  noindex
>
  <section class="ty-head">
    <h1>Thank you — we’ll be in touch</h1>
    <p>
      Your details are with our team. We usually reply the same working day with next steps, a
      price, or the questions we need answered to draw your dieline. If it is urgent, call us on
      the number in the header and mention you have just submitted a request.
    </p>
    <div class="ty-actions">
      <a class="btn btn-solid btn-lg" href="/">Back to home</a>
      <a class="btn btn-ghost btn-lg" href="/blog/">Read the blog</a>
    </div>
  </section>
  <section class="band wrap">
    <div class="ty-grid">
        <div>
          <h2>While you wait</h2>
          <ul>
            <li><a href="/how-to-order/">How ordering works</a></li>
            <li><a href="/artwork-guidelines/">Artwork guidelines for print files</a></li>
            <li><a href="/dieline-templates/">Dieline templates for display boxes</a></li>
            <li><a href="/how-much-do-custom-display-boxes-cost/">What display boxes cost</a></li>
          </ul>
        </div>
        <div>
          <h2>Popular display box styles</h2>
          <ul>
            {FEATURED_PRODUCTS.map((p) => (
              <li><a href={`/${p.slug}/`}>{p.name}</a></li>
            ))}
          </ul>
        </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ty-head {
    padding: clamp(48px, 6vw, 88px) var(--gut);
    background: var(--ink);
  }
  .ty-head h1 {
    color: #fff;
    max-width: 22ch;
  }
  .ty-head p {
    margin-block-start: 16px;
    max-width: 66ch;
    color: #d3deea;
    font-size: 1.125rem;
  }
  .ty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 28px;
  }
  .ty-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .ty-grid > div {
    padding: 22px;
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }
  .ty-grid h2 {
    font-size: 1.125rem;
    margin-block-end: 12px;
  }
  .ty-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-weight: 600;
  }
</style>
