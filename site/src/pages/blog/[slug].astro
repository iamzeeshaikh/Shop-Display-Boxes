---
import { withExtras, extraFaqs, extraHeading } from '../../lib/page-faqs';
import FaqAccordion from '../../components/FaqAccordion.astro';
/**
 * Blog article. Lives under /blog/ rather than at the root, which keeps
 * editorial content clearly separated from the commercial pages and avoids
 * competing with them in the root namespace.
 */
import { getImage, Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { headingId, readingTime, tableOfContents, type BlogPost } from '../../data/blog';
import {
  graph,
  webPage,
  breadcrumbs as breadcrumbSchema,
  article as articleSchema,
  type Crumb,
  faqPage,
} from '../../lib/schema';

export async function getStaticPaths() {
  const modules = import.meta.glob<{ default: BlogPost }>('../../content/blog/*.ts', {
    eager: true,
  });
  return Object.values(modules).map((m) => ({
    params: { slug: m.default.slug },
    props: { post: m.default },
  }));
}

interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
const url = `/blog/${post.slug}/`;
const minutes = readingTime(post);
const toc = tableOfContents(post);

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.title, url },
];

// Resolve the featured image from the shared product asset library.
// '!**/._*' keeps macOS AppleDouble sidecars (exFAT drive) out of the glob.
const imageModules = import.meta.glob<{ default: ImageMetadata }>([
  '../../assets/products/**/*.png',
  '!**/._*',
]);
const loader = imageModules[`../../assets/products/${post.image.productSlug}/${post.image.file}`];
if (!loader) {
  throw new Error(
    `Blog post "${post.slug}" references a missing image: ` +
      `src/assets/products/${post.image.productSlug}/${post.image.file}`
  );
}
const featured = (await loader()).default;
const ogImage = await getImage({ src: featured, width: 1200, format: 'webp' });

const schema = graph(
  webPage({
    url,
    name: post.title,
    description: post.metaDescription,
    datePublished: post.published,
    dateModified: post.updated,
  }),
  breadcrumbSchema(crumbs),
  articleSchema({
    url,
    headline: post.title,
    description: post.metaDescription,
    image: ogImage.src,
    datePublished: post.published,
    dateModified: post.updated,
    authorName: post.author,
  }),
  extraFaqs(Astro.url.pathname).length ? faqPage(extraFaqs(Astro.url.pathname)) : null
);

const publishedLabel = new Date(post.published + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const updatedLabel = new Date(post.updated + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Related articles, resolved from the same collection.
const allPosts = Object.values(
  import.meta.glob<{ default: BlogPost }>('../../content/blog/*.ts', { eager: true })
).map((m) => m.default);
const related = post.related
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is BlogPost => Boolean(p));
---

<BaseLayout
  url={url}
  title={post.metaTitle}
  description={post.metaDescription}
  ogType="article"
  ogImage={ogImage.src}
  ogImageAlt={post.image.alt}
  published={post.published}
  modified={post.updated}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />

  <article>
    <header class="ah">
      <div class="ah__copy">
        <h1>{post.title}</h1>
        <p class="ah__excerpt">{post.excerpt}</p>
        <p class="ah__meta">
          <span>{post.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.published}>{publishedLabel}</time>
          {
            post.updated !== post.published && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated <time datetime={post.updated}>{updatedLabel}</time>
                </span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          <span aria-hidden="true">·</span>
          <span>{post.tags.join(' · ')}</span>
        </p>
      </div>
      <div class="ah__photo">
        <Picture
          src={featured}
          alt={post.image.alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 64em) 45vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          class="ah__img"
        />
      </div>
    </header>

    <div class="band wrap">
      <div class="ab">
        <nav class="toc" aria-labelledby="toc-heading">
          <h2 class="toc__h" id="toc-heading">On this page</h2>
          <ol>
            {
              toc.map((entry) => (
                <li>
                  <a href={`#${entry.id}`}>{entry.heading}</a>
                  {entry.children.length > 0 && (
                    <ol>
                      {entry.children.map((child) => (
                        <li>
                          <a href={`#${child.id}`}>{child.heading}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="prose">
          {
            post.sections.map((section) => (
              <section>
                <h2 id={headingId(section.heading)}>{section.heading}</h2>
                {section.body.map((p) => (
                  <p>{p}</p>
                ))}
                {section.points && (
                  <ul>
                    {section.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
                {section.subsections?.map((sub) => (
                  <>
                    <h3 id={headingId(sub.heading)}>{sub.heading}</h3>
                    {sub.body.map((p) => (
                      <p>{p}</p>
                    ))}
                    {sub.points && (
                      <ul>
                        {sub.points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    )}
                  </>
                ))}
                {section.link && (
                  <p>
                    {section.link.text} <a href={section.link.href}>{section.link.anchor}</a>.
                  </p>
                )}
              </section>
            ))
          }

          {
            post.furtherReading && post.furtherReading.length > 0 && (
              <div class="nx">
                <h2>Where to go next</h2>
                <ul>
                  {post.furtherReading.map((l) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="band band--mist wrap">
          <h2 class="ra__h">Related articles</h2>
          <ul class="ra">
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.slug}/`}>
                  <span class="ra__title">{r.title}</span>
                  <span class="ra__excerpt">{r.excerpt}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
  {extraFaqs(Astro.url.pathname).length > 0 && (
    <section class="band wrap">
      <FaqAccordion faqs={extraFaqs(Astro.url.pathname)} heading={extraHeading(Astro.url.pathname)} />
    </section>
  )}
</BaseLayout>

<style>
  .ah {
    display: grid;
    background: var(--ink);
  }
  @media (min-width: 64em) {
    .ah {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }
  .ah__copy {
    padding: clamp(40px, 5vw, 72px) var(--gut);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ah h1 {
    color: #fff;
    max-width: 24ch;
  }
  .ah__excerpt {
    margin-block-start: 18px;
    color: #d3deea;
    font-size: 1.125rem;
    max-width: 60ch;
  }
  .ah__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-block-start: 24px;
    padding-block-start: 18px;
    border-block-start: 1px solid rgb(255 255 255 / 0.18);
    color: #b9c8d9;
    font-size: 14.5px;
  }
  .ah__photo :global(picture) {
    display: block;
    height: 100%;
  }
  .ah__img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    max-height: 560px;
    object-fit: cover;
  }

  .ab {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 62em) {
    .ab {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: clamp(40px, 5vw, 88px);
    }
    .toc {
      position: sticky;
      top: 104px;
      max-height: calc(100dvh - 130px);
      overflow-y: auto;
    }
  }
  .toc {
    padding: 20px;
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }
  .toc__h {
    font: 700 1rem/1.3 var(--font-display);
    margin-block-end: 12px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 14.5px;
  }
  .toc ol ol {
    margin: 8px 0 0 12px;
  }
  .toc a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--cobalt);
    text-decoration: underline;
  }

  .nx {
    margin-block-start: 48px;
    padding: 24px;
    background: var(--mist);
    border-radius: var(--r-lg);
  }
  .nx h2 {
    margin: 0 0 12px;
    padding: 0;
    border: 0;
    font-size: var(--t-xl);
  }

  .ra__h {
    margin-block-end: 20px;
  }
  .ra {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .ra a {
    display: block;
    height: 100%;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    text-decoration: none;
  }
  .ra a:hover {
    border-color: var(--cobalt);
  }
  .ra__title {
    display: block;
    font: 700 1.0625rem/1.35 var(--font-display);
    color: var(--ink);
  }
  .ra__excerpt {
    display: block;
    margin-block-start: 8px;
    font-size: 15px;
    color: var(--muted);
  }
</style>
