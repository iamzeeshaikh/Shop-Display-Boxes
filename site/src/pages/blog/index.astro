---
import { withExtras, extraFaqs, extraHeading } from '../../lib/page-faqs';
import FaqAccordion from '../../components/FaqAccordion.astro';
/**
 * Blog index.
 *
 * Articles are grouped by tag for scanning, but tags do not generate their own
 * URLs — a tag archive across twenty articles would be a thin page competing
 * with the articles themselves. Grouping here is a UI device only.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { readingTime, type BlogPost, type BlogTag } from '../../data/blog';
import { graph, webPage, breadcrumbs as breadcrumbSchema, type Crumb, faqPage } from '../../lib/schema';

const posts = Object.values(
  import.meta.glob<{ default: BlogPost }>('../../content/blog/*.ts', { eager: true })
)
  .map((m) => m.default)
  .sort((a, b) => (a.published < b.published ? 1 : -1));

// '!**/._*' keeps macOS AppleDouble sidecars (exFAT drive) out of the glob.
const imageModules = import.meta.glob<{ default: ImageMetadata }>([
  '../../assets/products/**/*.png',
  '!**/._*',
]);

const cards = await Promise.all(
  posts.map(async (post) => {
    const key = `../../assets/products/${post.image.productSlug}/${post.image.file}`;
    const loader = imageModules[key];
    return {
      post,
      minutes: readingTime(post),
      image: loader ? (await loader()).default : undefined,
    };
  })
);

// Tag counts, for the scanning strip. No tag links to its own page.
const tagCounts = new Map<BlogTag, number>();
for (const p of posts) for (const t of p.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const url = '/blog/';
const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url },
];

const seo = {
  url,
  title: 'Display Packaging Blog | Practical Guides for Buyers',
  description:
    'Practical articles on display packaging: materials, printing, structural design, costs, and ordering, written for buyers.',
};

const schema = graph(
  webPage({ url, name: 'Display Packaging Blog', description: seo.description, type: 'CollectionPage' }),
  breadcrumbSchema(crumbs),
  extraFaqs(Astro.url.pathname).length ? faqPage(extraFaqs(Astro.url.pathname)) : null
);

const [lead, ...rest] = cards;
---

<BaseLayout {...seo} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="bh">
    <h1>Display packaging, explained</h1>
    <p class="bh__intro">
      Articles on materials, printing, structure, and cost — written for the person specifying
      packaging rather than for search engines. Every one of them is about a decision you will
      actually have to make.
    </p>
    {
      tags.length > 0 && (
        <ul class="bh__topics" aria-label="Topics covered">
          {tags.map(([tag, count]) => (
            <li>
              {tag} <span>{count}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    lead && (
      <section class="band--tight wrap">
        <a class="bl" href={`/blog/${lead.post.slug}/`}>
          {lead.image && (
            <Image
              src={lead.image}
              alt={lead.post.image.alt}
              widths={[520, 1040]}
              sizes="(min-width: 60em) 50vw, 94vw"
              format="webp"
              loading="eager"
              fetchpriority="high"
              class="bl__img"
            />
          )}
          <div class="bl__body">
            <h2>{lead.post.title}</h2>
            <p class="bl__excerpt">{lead.post.excerpt}</p>
            <p class="bc__meta">
              {lead.post.tags[0]} · {lead.post.author} · {lead.minutes} min read
            </p>
          </div>
        </a>
      </section>
    )
  }

  <section class="band--tight wrap">
    <ul class="bg">
      {
        rest.map(({ post, minutes, image }) => (
          <li class="bc">
            <a href={`/blog/${post.slug}/`}>
              {image && (
                <Image
                  src={image}
                  alt={post.image.alt}
                  widths={[300, 600]}
                  sizes="(min-width: 80em) 24vw, (min-width: 40em) 45vw, 94vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="bc__img"
                />
              )}
              <div class="bc__body">
                <h2 class="bc__title">{post.title}</h2>
                <p class="bc__excerpt">{post.excerpt}</p>
                <p class="bc__meta">{post.tags[0]} · {minutes} min read</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  {extraFaqs(Astro.url.pathname).length > 0 && (
    <section class="band wrap">
      <FaqAccordion faqs={extraFaqs(Astro.url.pathname)} heading={extraHeading(Astro.url.pathname)} />
    </section>
  )}
</BaseLayout>

<style>
  .bh {
    padding: clamp(40px, 5vw, 72px) var(--gut);
    background: var(--ink);
  }
  .bh h1 {
    color: #fff;
  }
  .bh__intro {
    margin-block-start: 16px;
    max-width: 66ch;
    color: #d3deea;
    font-size: 1.125rem;
  }
  .bh__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
  }
  .bh__topics li {
    padding: 7px 12px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 8px;
    color: #e4ecf5;
    font-size: 14px;
    font-weight: 600;
  }
  .bh__topics span {
    color: var(--cobalt-light);
    margin-inline-start: 4px;
  }

  .bl {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
  }
  @media (min-width: 60em) {
    .bl {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
  .bl__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .bl__body {
    padding: clamp(24px, 3.5vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--mist);
  }
  .bl h2 {
    font-size: var(--t-3xl);
  }
  .bl:hover h2 {
    color: var(--cobalt);
  }
  .bl__excerpt {
    margin-block: 14px 18px;
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  .bg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .bc a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast);
  }
  .bc a:hover {
    border-color: var(--cobalt);
  }
  .bc__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .bc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 20px 20px;
  }
  .bc__title {
    font-size: 1.125rem;
    line-height: 1.35;
  }
  .bc a:hover .bc__title {
    color: var(--cobalt);
  }
  .bc__excerpt {
    flex: 1;
    margin-block: 8px 12px;
    color: var(--muted);
    font-size: 15px;
  }
  .bc__meta {
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
  }
</style>
