---
import { withExtras, extraFaqs, extraHeading } from '../lib/page-faqs';
/**
 * Homepage.
 *
 * Deliberately omitted: testimonials, client logos, counters, awards, and
 * certifications. None has been supplied, and the brief forbids inventing them.
 * The trust sections here are built from what is verifiable — how the work is
 * done — rather than from social proof that does not exist yet.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import DesignYourBox from '../components/DesignYourBox.astro';
import OrderBand from '../components/OrderBand.astro';
import { photo, photoOf } from '../lib/photos';
import { HOME_PHOTOS, GALLERY_PICK, INDUSTRY_PHOTOS } from '../data/showroom';
import { FEATURED_PRODUCTS, PRODUCTS, getProduct } from '../data/products';
import { business } from '../data/business';
import { graph, organization, localBusiness, website, webPage, faqPage } from '../lib/schema';

const seo = {
  url: '/',
  title: 'Custom Display Boxes & Retail Display Packaging | USA',
  description:
    'Custom printed display boxes built around your product, with free dielines and low minimums. Shipped to businesses across the USA.',
};

const price = business.packPrice.value;

const range = await Promise.all(
  PRODUCTS.map(async (p) => ({ product: p, image: await photo(p.slug, GALLERY_PICK[p.slug] ?? 1) }))
);
const groups = ['By placement', 'By material', 'By format', 'By industry'] as const;

const heroImage = await photoOf(HOME_PHOTOS.hero);
const placementImages = {
  counter: await photoOf(HOME_PHOTOS.placement.counter),
  shelf: await photoOf(HOME_PHOTOS.placement.shelf),
  floor: await photoOf(HOME_PHOTOS.placement.floor),
};
const specImages = {
  material: await photoOf(HOME_PHOTOS.spec.material),
  printing: await photoOf(HOME_PHOTOS.spec.printing),
  finishing: await photoOf(HOME_PHOTOS.spec.finishing),
  size: await photoOf(HOME_PHOTOS.spec.size),
};
const structureImage = await photoOf(HOME_PHOTOS.structure);
const closeImage = await photoOf(HOME_PHOTOS.close);

const gallery = await Promise.all(
  [
    'corrugated-display-boxes',
    'candle-display-boxes',
    'display-gift-boxes',
    'counter-display-boxes',
    'soap-display-boxes',
    'display-trays',
  ].map(async (slug) => ({ slug, name: getProduct(slug).name, image: await photo(slug, 1) }))
);

const steps = [
  { title: 'Specification and quote.', body: 'Send the product, a quantity, and where it will sit.' },
  { title: 'Dieline — first approval.', body: 'Drawn around your real product. This fixes the structure.' },
  { title: 'Artwork.', body: 'Placed onto that dieline rather than designed to a rectangle.' },
  { title: 'Proof — second approval.', body: 'This fixes color and content. Changes after it are a new job.' },
  { title: 'Production.', body: 'Each stage checked against the approved proof, not the previous stage.' },
  { title: 'Delivery.', body: 'Usually flat-packed, since freight is billed on volume.' },
];

const industries = [
  { label: 'Cosmetics & beauty', href: '/cosmetic-packaging/' },
  { label: 'Food & beverage', href: '/food-display-packaging/' },
  { label: 'Candles', href: '/candle-packaging/' },
  { label: 'Soap & bath', href: '/soap-packaging/' },
  { label: 'Supplements', href: '/supplement-display-packaging/' },
  { label: 'Pharmacy', href: '/pharmaceutical-display-packaging/' },
  { label: 'Electronics', href: '/electronics-display-packaging/' },
  { label: 'Jewelry', href: '/jewelry-display-packaging/' },
  { label: 'Confectionery', href: '/confectionery-display-packaging/' },
  { label: 'Pet products', href: '/pet-product-display-packaging/' },
  { label: 'Toys', href: '/toy-display-packaging/' },
  { label: 'Retail (general)', href: '/retail-packaging/' },
];

const industryTiles = await Promise.all(
  industries.map(async (i) => ({ ...i, image: await photoOf(INDUSTRY_PHOTOS[i.href]) }))
);

const faqs = [
  { question: 'What does a custom display box cost?', answer: `${price.statement} Larger runs, custom sizes and specialty finishes are quoted, and there quantity is the largest single driver, because setup costs are fixed and spread across the run — which is why halving an order does not halve the invoice.` },
  { question: 'Do you charge for dielines?', answer: 'No. We draw a dieline around your product before you commit to anything, supplied as a layered vector file with cut, crease, and bleed on separate layers. It is yours to keep.' },
  { question: 'What is your minimum order?', answer: 'Minimum order is 100 units. Digital printing removes plate setup, which is what makes a run that short viable — expect a higher per-piece price at 100 than at volume, because fixed setup costs are spread across fewer pieces.' },
  { question: 'How do I know whether I need cardboard or corrugated?', answer: 'Load the display to its intended assortment, lift it by one edge, and watch the base. If it bows, you need corrugated. Then repeat the test after several days loaded — paperboard fails gradually, so day-one results mislead.' },
  { question: 'What do you need from me to start?', answer: 'The product itself, or its dimensions at the widest point, plus a quantity and where the display will sit. For anything with a cavity insert, send a physical unit — spec sheets omit the cap flare and label thickness that decide fit.' },
  { question: 'Where do you ship?', answer: 'To the United States, the United Kingdom, Canada and Australia, with shipping free on every order. Production takes 5–7 business days after proof approval, then delivery takes 5–7 business days in the US and 7–10 business days to the UK, Canada and Australia. We do not maintain offices, production facilities, or collection points in individual states or cities — everything is produced to order and shipped to you.' },
  { question: 'Do you check that my labeling is compliant?', answer: 'No, in any market. We print exactly the artwork you supply including ingredient lists, warnings, and safety marks, but responsibility for accuracy and regulatory compliance stays with you.' },
  { question: 'Do you have customer reviews?', answer: 'Not yet, and we are not publishing any until we have verified ones from real customers. There are no star ratings anywhere on this site, and none in its structured data either.' },
];

const schema = graph(
  organization(),
  localBusiness(),
  website(),
  webPage({ url: '/', name: seo.title, description: seo.description }),
  faqPage(withExtras('/', faqs))
);
---

<BaseLayout {...seo} schema={schema}>
  {/* ── Hero: full-bleed product photo, copy on the navy shade ─────────── */}
  <section class="hx">
    <Image
      src={heroImage}
      alt="Printed counter display box holding sport gels and pump bottles"
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 40em) 50vw, 100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="hx__img"
    />
    <div class="hx__shade" aria-hidden="true"></div>
    <div class="hx__copy">
      <h1>Display boxes built around your product, not around a stock size</h1>
      <p class="hx__lede">
        A display that holds your product approximately is a display whose front row leans within
        a week — and a leaning row stops selling. We draw a dieline around the real thing before
        you commit to anything.
      </p>
      <div class="hx__actions">
        <a class="btn btn-solid btn-lg" href="/request-a-quote/">Request a quote</a>
        <a class="btn btn-ghost btn-lg" href="/get-a-free-dieline/">Get a free dieline</a>
      </div>
      <ul class="hx__facts">
        <li>Free dielines drawn from your actual product</li>
        <li>Low minimums — digital printing removes plate setup</li>
        <li>Free shipping to the US, UK, Canada and Australia</li>
      </ul>
    </div>
  </section>

  {/* ── Placement: three edge-to-edge photo panels ─────────────────────── */}
  <section class="pl" aria-labelledby="pl-h">
    <div class="pl__head wrap">
      <h2 id="pl-h">Narrow it down in one question: where will it sit?</h2>
      <p>
        Placement sets the footprint you are allowed and the angle a shopper views from, and both
        constrain everything downstream. It is the most useful first filter there is.
      </p>
    </div>
    <div class="pl__row">
      <a class="pl__panel" href="/counter-display-boxes/">
        <Image src={placementImages.counter} alt="Corrugated counter display with a printed summer header card" widths={[480, 720]} sizes="(min-width: 60em) 33vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div class="pl__text">
          <h3>On a counter</h3>
          <p>Small footprint, steep viewing angle, easiest placement to win. Build upward, not outward.</p>
          <span class="pl__link">Counter display boxes</span>
        </div>
      </a>
      <a class="pl__panel" href="/shelf-ready-display-boxes/">
        <Image src={placementImages.shelf} alt="Orange shelf-ready display box with a hexagon window" widths={[480, 720]} sizes="(min-width: 60em) 33vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div class="pl__text">
          <h3>On a shelf</h3>
          <p>Planogram constrained, and increasingly governed by shelf-ready specifications from the chain.</p>
          <span class="pl__link">Shelf-ready display boxes</span>
        </div>
      </a>
      <a class="pl__panel" href="/cardboard-display-stands/">
        <Image src={placementImages.floor} alt="Pink and black floor display stand with four printed shelves" widths={[480, 720]} sizes="(min-width: 60em) 33vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div class="pl__text">
          <h3>On the floor</h3>
          <p>Highest stock capacity, most negotiation, and the structure that has to carry its own load.</p>
          <span class="pl__link">Cardboard display stands</span>
        </div>
      </a>
    </div>
  </section>

  {/* ── Range: every style as a photo tile, filterable ─────────────────── */}
  <section class="rg wrap" aria-labelledby="rg-h">
    <div class="sec-head">
      <div>
        <h2 id="rg-h">Selected formats</h2>
        <p>
          All {PRODUCTS.length} styles are in the{' '}
          <a href="/display-box-packaging/">display packaging overview</a>.
        </p>
      </div>
      <div class="rg__tabs" role="group" aria-label="Filter display box styles">
        <button type="button" class="is-on" data-f="all" aria-pressed="true">All {PRODUCTS.length}</button>
        {groups.map((g) => (
          <button type="button" data-f={g} aria-pressed="false">{g}</button>
        ))}
      </div>
    </div>
    <ul class="rg__grid">
      {
        range.map(({ product, image }) => (
          <li data-g={product.group}>
            <a href={`/${product.slug}/`}>
              <Image
                src={image}
                alt={`${product.name} — custom printed display box`}
                widths={[280, 560]}
                sizes="(min-width: 80em) 19vw, (min-width: 40em) 30vw, 48vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
              <div class="rg__info">
                <h3>{product.name}</h3>
                <p>{product.searchIntent}</p>
                <span>View style</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <DesignYourBox id="dyb-home" />

  <OrderBand id="order" />

  {/* ── Structure: the six-panel argument beside a real box ───────────── */}
  <section class="st" aria-labelledby="st-h">
    <div class="st__photo">
      <Image src={structureImage} alt="Printed counter display box with a tall header card" widths={[480, 720, 960]} sizes="(min-width: 60em) 45vw, 100vw" format="webp" loading="lazy" decoding="async" />
    </div>
    <div class="st__copy">
      <h2 id="st-h">Six panels, and every one of them is a decision</h2>
      <p>
        A display box is not a printed rectangle. The front panel sells, the side walls carry the
        load, the base decides whether the front row is still standing in a fortnight, and the
        header card is the only part a shopper sees from across an aisle. They are drawn together
        or they fight each other.
      </p>
    </div>
  </section>

  {/* ── How ordering works ────────────────────────────────────────────── */}
  <section class="sp wrap" aria-labelledby="sp-h">
    <div class="sec-head">
      <div>
        <h2 id="sp-h">Six stages, two of which carry the risk</h2>
        <p>
          The full sequence and what to check at each approval is under{' '}
          <a href="/how-to-order/">how ordering works</a>.
        </p>
      </div>
    </div>
    <ol class="sp__list">
      {
        steps.map((step) => (
          <li>
            <strong>{step.title}</strong> {step.body}
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── The four decisions ─────────────────────────────────────────────── */}
  <section class="dc wrap" aria-labelledby="dc-h">
    <div class="sec-head">
      <div>
        <h2 id="dc-h">The four decisions that set your quote</h2>
      </div>
    </div>
    <div class="dc__cards">
      <article class="dc__card">
        <Image src={specImages.material} alt="Plain kraft display box with a tall header" widths={[400, 600]} sizes="(min-width: 70em) 23vw, (min-width: 40em) 45vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div>
          <h3>Material</h3>
          <p>
            Folding boxboard prints best and suits light units. Corrugated carries load and survives
            transit. The dividing line is weight against unsupported base span — not category.
          </p>
          <a href="/box-materials/">Board and box materials</a>
        </div>
      </article>
      <article class="dc__card">
        <Image src={specImages.printing} alt="Tiered tea display printed in full color" widths={[400, 600]} sizes="(min-width: 70em) 23vw, (min-width: 40em) 45vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div>
          <h3>Printing</h3>
          <p>
            Digital removes plate setup and wins on short runs. Offset overtakes it at volume.
            Litho-lamination gives carton print quality on a shipper-grade structure.
          </p>
          <a href="/custom-printing-options/">Custom printing options</a>
        </div>
      </article>
      <article class="dc__card">
        <Image src={specImages.finishing} alt="Window gift box with a gold foil interior" widths={[400, 600]} sizes="(min-width: 70em) 23vw, (min-width: 40em) 45vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div>
          <h3>Finishing</h3>
          <p>
            A durability decision before a visual one — and the decision that determines whether the
            board stays in the paper recycling stream.
          </p>
          <a href="/finishes-and-add-ons/">Finishes and add-ons</a>
        </div>
      </article>
      <article class="dc__card">
        <Image src={specImages.size} alt="Kraft corrugated display box with a die-cut front" widths={[400, 600]} sizes="(min-width: 70em) 23vw, (min-width: 40em) 45vw, 100vw" format="webp" loading="lazy" decoding="async" />
        <div>
          <h3>Size</h3>
          <p>
            Measured at the widest point, which is usually the cap rather than the body. Internal
            dimensions are the ones that matter, and board thickness changes them.
          </p>
          <a href="/custom-box-sizes/">Custom box sizes</a>
        </div>
      </article>
    </div>
  </section>

  {/* ── Pricing ───────────────────────────────────────────────────────── */}
  <section class="pr">
    <div class="pr__main">
      <h2>What it costs, honestly</h2>
      <p class="pr__statement">{price.statement}</p>
      <p class="pr__qualifier">{price.qualifier}</p>
      <p><a class="btn btn-solid" href="#order">Order 100 boxes online</a></p>
      <p class="more-link">
        Each cost driver is broken down in the guide to{' '}
        <a href="/how-much-do-custom-display-boxes-cost/">what custom display boxes cost</a>.
      </p>
    </div>
    <div class="pr__aside">
      <h3>Low minimums</h3>
      <p>
        Digital printing removes plate setup, which is what makes genuinely short runs viable. The
        actual minimum depends on structure, board, and print route — we confirm it with your
        quote rather than publishing a number that would not hold for every job.
      </p>
      <a class="btn btn-ghost" href="/low-minimum-orders/">Low minimum orders</a>
    </div>
  </section>

  {/* ── Industries ────────────────────────────────────────────────────── */}
  <section class="in" aria-labelledby="in-h">
    <div class="sec-head">
      <div>
        <h2 id="in-h">Different categories break in different ways</h2>
        <p>
          Glass weight for candles. Oil migration for soap. Food-contact coatings for bakery. Warning
          copy claiming panel space before design starts. The constraint changes by category.
        </p>
      </div>
    </div>
    <ul class="in__grid">
      {industryTiles.map((i) => (
        <li>
          <a href={i.href}>
            <Image src={i.image} alt="" widths={[240, 400]} sizes="(min-width: 80em) 15vw, (min-width: 40em) 24vw, 48vw" format="webp" loading="lazy" decoding="async" />
            <span>{i.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── What you get ──────────────────────────────────────────────────── */}
  <section class="wg wrap" aria-labelledby="wg-h">
    <div class="sec-head">
      <div>
        <h2 id="wg-h">Support that prevents reprints rather than explaining them</h2>
      </div>
    </div>
    <div class="wg__grid">
      <article>
        <h3>Free dielines and artwork checks</h3>
        <p>
          We draw the dieline and check your file against it before press — bleed, safe area,
          resolution, color space, and whether live copy crosses a crease. Those are the faults
          behind most reprints, and all are cheap to fix beforehand.
        </p>
        <a href="/free-design-support/">Free design support</a>
      </article>
      <article>
        <h3>Checked against the proof</h3>
        <p>
          Every production stage is checked against the approved proof rather than the stage
          before it, so a small drift cannot compound down the line. Displays with inserts get a
          loaded fit check before the run completes.
        </p>
        <a href="/quality-assurance/">Our quality assurance process</a>
      </article>
      <article>
        <h3>Recyclable specifications</h3>
        <p>
          The coating determines recyclability more than the board or its recycled content. If it
          is a requirement, settle it before choosing a finish — a film laminate takes board out
          of the paper stream in most municipalities.
        </p>
        <a href="/sustainability/">Sustainable board options</a>
      </article>
      <article>
        <h3>Shipped across the USA</h3>
        <p>
          Free to any business address in the US, and to the UK, Canada and Australia. Freight
          on display packaging is billed on volume rather than weight, which is why flat-packing
          changes the delivered cost so substantially.
        </p>
        <a href="/shipping-information/">Shipping and delivery information</a>
      </article>
    </div>
  </section>

  {/* ── Work ──────────────────────────────────────────────────────────── */}
  <section class="wk wrap" aria-labelledby="wk-h">
    <div class="sec-head">
      <div>
        <h2 id="wk-h">Production work, by the problem it solved</h2>
        <p>
          More in the <a href="/portfolio/">our display box portfolio</a>, organized by the constraint each structure
          had to solve.
        </p>
      </div>
    </div>
    <ul class="wk__strip">
      {
        gallery.map(({ slug, name, image }) => (
          <li>
            <a href={`/${slug}/`}>
              <Image src={image} alt={`${name} — production example`} widths={[260, 520]} sizes="(min-width: 60em) 16vw, 48vw" format="webp" loading="lazy" decoding="async" />
              <span>{name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band wrap">
    <FaqAccordion faqs={withExtras('/', faqs)} heading="Common questions" />
  </section>

  {/* ── Closing CTA: full-bleed photo ─────────────────────────────────── */}
  <section class="cl">
    <Image src={closeImage} alt="Teal soap counter display packed with printed soap boxes" widths={[600, 900, 1200]} sizes="(min-width: 40em) 62vw, 100vw" format="webp" loading="lazy" decoding="async" class="cl__img" />
    <div class="cl__copy">
      <h2>Send the product, not the measurements</h2>
      <p>
        For anything with an insert, the dimensions that decide fit are the ones no spec sheet
        records. We will draw the dieline around the real thing and come back with a structure,
        a board, and a price.
      </p>
      <a class="btn btn-solid btn-lg" href="/request-a-quote/">Request a quote</a>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.rg__tabs button');
  const tiles = document.querySelectorAll<HTMLElement>('.rg__grid li');
  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      tabs.forEach((b) => {
        b.classList.toggle('is-on', b === t);
        b.setAttribute('aria-pressed', String(b === t));
      });
      const f = t.dataset.f;
      tiles.forEach((li) => {
        li.hidden = f !== 'all' && li.dataset.g !== f;
      });
    });
  });
</script>

<style>
  /* Hero */
  .hx {
    position: relative;
    overflow: hidden;
    min-height: clamp(560px, 46vw, 700px);
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, #67909a 0%, #5a808a 45%, #4f737c 100%);
  }
  .hx__img {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: auto;
    max-width: none;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%);
    mask-image: linear-gradient(90deg, transparent 0, #000 22%);
  }
  .hx__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(9 20 36 / 0.9) 0%, rgb(9 20 36 / 0.74) 36%, rgb(9 20 36 / 0.16) 64%, rgb(9 20 36 / 0) 78%),
      linear-gradient(0deg, rgb(9 20 36 / 0.35), rgb(9 20 36 / 0) 35%);
  }
  .hx__copy {
    position: relative;
    z-index: 1;
    padding: 64px var(--gut);
    max-width: calc(660px + 2 * var(--gut));
  }
  .hx h1 {
    color: #fff;
    font-size: clamp(2.125rem, 3.5vw, 3.125rem);
    line-height: 1.12;
  }
  .hx__lede {
    margin-block-start: 20px;
    max-width: 560px;
    color: #d7e2ee;
    font-size: 1.125rem;
  }
  .hx__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 30px;
  }
  .hx__facts {
    list-style: none;
    margin: 36px 0 0;
    padding: 22px 0 0;
    border-block-start: 1px solid rgb(255 255 255 / 0.22);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px 28px;
    color: #e4ecf5;
    font: 600 15px/1.45 var(--font-sans);
  }
  .hx__facts li {
    padding-inline-start: 14px;
    border-inline-start: 2px solid var(--cobalt-light);
  }

  /* Placement panels */
  .pl__head {
    padding-block: 64px 28px;
    max-width: calc(820px + 2 * var(--gut));
  }
  .pl__head p {
    margin-block-start: 12px;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .pl__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .pl__panel {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3.1;
    overflow: hidden;
    text-decoration: none;
    background: var(--ink);
  }
  .pl__panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pl__panel:hover img {
    transform: scale(1.04);
  }
  .pl__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 90px 32px 28px;
    background: linear-gradient(0deg, rgb(9 20 36 / 0.9) 0%, rgb(9 20 36 / 0.65) 55%, rgb(9 20 36 / 0) 100%);
  }
  .pl__text h3 {
    color: #fff;
    font-size: 1.5rem;
  }
  .pl__text p {
    margin-block-start: 6px;
    max-width: 400px;
    color: #d3deea;
    font-size: 15px;
  }
  .pl__link {
    display: inline-block;
    margin-block-start: 12px;
    padding-block-end: 2px;
