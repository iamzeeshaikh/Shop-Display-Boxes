---
/**
 * Pricing panel on every product page. One price story, from src/data/order.ts:
 * the online pack is 100 display boxes for $60.00, the same figure as the order
 * band, the Offer JSON-LD and the Merchant feed. Anything else is quoted.
 */
import { PRICE_LINE, PRODUCTION_TEXT } from '../data/order';
---

<aside class="pn" aria-labelledby="pricing-heading">
  <h2 class="pn__h" id="pricing-heading">Pricing</h2>
  <p class="pn__statement">{PRICE_LINE}</p>
  <p class="pn__qualifier">
    That is the online price for a pack of 100 in this style, printed full color to your artwork,
    with free shipping to the US, UK, Canada and Australia. Production takes {PRODUCTION_TEXT} after you approve the proof.
    Larger runs, custom sizes, specialty board, inserts and premium finishes are priced by quote
    against your actual specification.
  </p>
  <a class="btn btn-solid" href="#order">Order 100 boxes online</a>
  <p class="pn__alt"><a href="/request-a-quote/">Get a quote for a larger or custom run</a></p>
</aside>

<style>
  .pn {
    padding: 28px;
    background: var(--ink);
    color: #c4d1e0;
    border-radius: var(--r-lg);
  }
  .pn :global(a:not(.btn)) {
    color: var(--cobalt-light);
  }
  .pn__h {
    font: 800 1.375rem/1.25 var(--font-display);
    color: #fff;
    margin-block-end: 12px;
  }
  .pn__statement {
    font: 700 1.125rem/1.4 var(--font-display);
    color: #fff;
  }
  .pn__qualifier {
    margin-block: 14px 22px;
    font-size: 15px;
  }
  .pn__alt {
    margin-block-start: 14px;
    font-size: 15px;
    font-weight: 600;
  }
  .pn .btn {
    width: 100%;
  }
</style>
