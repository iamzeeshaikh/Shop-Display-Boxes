---
/**
 * Sticky quote panel used in the sidebar of commercial and industry pages.
 * Deliberately does not repeat the $0.30 pricing statement — that belongs on
 * product pages, where the Offer schema mirrors it.
 */
---

<aside class="qp" aria-labelledby="qp-heading">
  <h2 class="qp__h" id="qp-heading">Get a price</h2>
  <p class="qp__body">
    Send your dimensions, quantity, and what you are packing. If you do not have dimensions yet,
    send the product — we size the box around it and draw the dieline before you commit.
  </p>
  <a class="btn btn-solid" href="/request-a-quote/">Request a quote</a>
  <ul class="qp__list">
    <li><a href="/sample-request/">Request a sample</a></li>
    <li><a href="/get-a-free-dieline/">Get a free dieline</a></li>
    <li><a href="/contact-us/">Talk to someone</a></li>
  </ul>
</aside>

<style>
  .qp {
    padding: 28px;
    background: var(--ink);
    color: #c4d1e0;
    border-radius: var(--r-lg);
  }
  .qp :global(a:not(.btn)) {
    color: var(--cobalt-light);
  }
  .qp__h {
    font: 800 1.375rem/1.25 var(--font-display);
    color: #fff;
    margin-block-end: 12px;
  }
  .qp__body {
    margin-block-end: 20px;
    font-size: 15px;
  }
  .qp .btn {
    width: 100%;
  }
  .qp__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 16px 0 0;
    border-block-start: 1px solid rgb(255 255 255 / 0.16);
    display: grid;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
  }
</style>
