---
/**
 * Logo: open display-box mark + "Shop Display Boxes" in Title Case.
 * `inverse` is the footer version (cobalt tile on the dark footer).
 */
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['brand', inverse && 'brand--inv']}>
  <svg class="brand__mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="10" fill={inverse ? '#1d5fd1' : '#0d1b2e'}></rect>
    <path d="M11 13h18v6H11z" fill={inverse ? '#bcd6ff' : '#5fa3ff'}></path>
    <path d="M8 20h24l-3 11H11z" fill="#fff"></path>
    <path d="M13 24h14" stroke={inverse ? '#1d5fd1' : '#0d1b2e'} stroke-width="1.6"></path>
  </svg>
  <span class="brand__name">Shop Display Boxes</span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .brand__mark {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .brand__name {
    font: 800 20px/1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .brand--inv .brand__name {
    color: #fff;
  }
  @media (max-width: 640px) {
    .brand__mark {
      width: 34px;
      height: 34px;
    }
    .brand__name {
      font-size: 17px;
    }
  }
</style>
