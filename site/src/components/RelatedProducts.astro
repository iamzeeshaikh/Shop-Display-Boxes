---
/**
 * Related products. Kept to a small, hand-picked set per product — these are
 * chosen for genuine relevance in the product content file, not generated to
 * fill a grid.
 */
import { Image } from 'astro:assets';
import { getProduct } from '../data/products';
import manifest from '../assets/products/manifest.json';

interface Props {
  slugs: string[];
  heading?: string;
}
const { slugs, heading = 'Related display packaging' } = Astro.props;

// '!**/._*' keeps macOS AppleDouble sidecars (exFAT drive) out of the glob.
const modules = import.meta.glob<{ default: ImageMetadata }>([
  '../assets/products/**/*.png',
  '!**/._*',
]);

const items = await Promise.all(
  slugs.map(async (slug) => {
    const product = getProduct(slug);
    const first = (manifest as Record<string, Array<{ file: string }>>)[slug]?.[0]?.file;
    const load = first ? modules[`../assets/products/${slug}/${first}`] : undefined;
    return { product, image: load ? (await load()).default : undefined };
  })
);
---

<section class="rp">
  <h2>{heading}</h2>
  <ul class="rp__grid">
    {
      items.map(({ product, image }) => (
        <li class="rp__item">
          <a class="rp__link" href={`/${product.slug}/`}>
            {image && (
              <Image
                src={image}
                alt={`${product.name} — custom printed display packaging`}
                widths={[220, 440]}
                sizes="(min-width: 48em) 15rem, 45vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="rp__img"
              />
            )}
            <span class="rp__name">{product.name}</span>
          </a>
          <p class="rp__intent">{product.searchIntent}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .rp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 16px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .rp__item {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color var(--dur-fast);
  }
  .rp__item:hover {
    border-color: var(--cobalt);
  }
  .rp__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .rp__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .rp__name {
    display: block;
    padding: 14px 16px 0;
    font: 700 1rem/1.3 var(--font-display);
    color: var(--ink);
  }
  .rp__link:hover .rp__name {
    color: var(--cobalt);
  }
  .rp__intent {
    padding: 6px 16px 16px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
