---
/**
 * "Order online" band: 100 display boxes for $60.00, on the home page, every
 * product page, and the industry and hub pages that carry Design Your Display
 * Box. Price, shipping and payment wording come from src/data/order.ts — the
 * same constants as the Product Offer JSON-LD, the Merchant feed and
 * /checkout/ — so the band, the listing and the order cannot disagree.
 *
 * With `product` set (product pages) the band sells that style. Without it the
 * visitor picks a style; `defaultSlug` preselects one. The button opens
 * /checkout/ with the style and pack count; nothing is charged on the site.
 */
import { Image } from 'astro:assets';
import { HOME_PHOTOS, GALLERY_PICK } from '../data/showroom';
import { PRODUCTS } from '../data/products';
import { photoOf, type PhotoRef } from '../lib/photos';
import {
  PACK_QTY,
  PACK_PRICE,
  MAX_PACKS,
  PRICE_LINE,
  SHIP_LINE,
  PRODUCTION_TEXT,
  TRANSIT_US_TEXT,
  TRANSIT_INTL_TEXT,
  PAYMENT_LINE,
  money,
} from '../data/order';

interface Props {
  product?: { slug: string; name: string };
  defaultSlug?: string;
  id?: string;
}
const { product, defaultSlug = 'custom-display-boxes', id = 'order' } = Astro.props;

const ref: PhotoRef = product
  ? { slug: product.slug, n: GALLERY_PICK[product.slug] ?? 1 }
  : HOME_PHOTOS.order;
const img = await photoOf(ref);
const alt = product
  ? `${product.name}, printed and ready to fill`
  : 'Printed counter display box with a tiered insert';
const headingId = `${id}-h`;
---

<section class="ob" id={id} aria-labelledby={headingId}>
  <div class="ob__photo">
    <Image src={img} alt={alt} widths={[480, 720, 960]} sizes="(min-width: 60em) 50vw, 100vw" format="webp" loading="lazy" decoding="async" />
  </div>
  <form class="ob__panel" action="/checkout/" method="get" data-ob data-pack={PACK_PRICE} data-qty={PACK_QTY}>
    <h2 id={headingId}>
      Order online: {product ? product.name.toLowerCase() : 'display boxes'} — <span class="ob__price">{money(PACK_PRICE)}</span> per {PACK_QTY}
    </h2>
    <p class="ob__line">{PRICE_LINE}</p>
    <p>
      A standard display box in this style, printed full color to your artwork and delivered flat.
      Larger runs, a different size or specialty board are quoted —
      <a href="/request-a-quote/">ask for a quote</a> instead.
    </p>
    <ul class="ob__spec">
      {
        product ? (
          <li><span>Style</span>{product.name}</li>
        ) : (
          <li>
            <label for={`${id}-style`}>Style</label>
            <select id={`${id}-style`} name="add" class="ob__select">
              {PRODUCTS.map((p) => <option value={p.slug} selected={p.slug === defaultSlug}>{p.name}</option>)}
            </select>
          </li>
        )
      }
      <li><span>Print</span>Full color, one side, matte</li>
      <li><span>Production</span>{PRODUCTION_TEXT} after proof approval</li>
      <li><span>Delivery</span>{TRANSIT_US_TEXT} in the US, {TRANSIT_INTL_TEXT} to the UK, Canada and Australia</li>
    </ul>
    {product && <input type="hidden" name="add" value={product.slug} />}
    <input type="hidden" name="packs" value="1" data-ob-packs />
    <div class="ob__buy">
      <div class="ob__stepper" data-ob-max={MAX_PACKS}>
        <button type="button" aria-label="One pack fewer" data-ob-minus>−</button>
        <output aria-live="polite" data-ob-count>1</output>
        <button type="button" aria-label="One pack more" data-ob-plus>+</button>
      </div>
      <p class="ob__units"><span data-ob-units>{PACK_QTY}</span> boxes · <span data-ob-total>{money(PACK_PRICE)}</span></p>
      <button type="submit" class="btn btn-solid btn-lg">Order Now</button>
    </div>
    <p class="ob__ship">{SHIP_LINE}. {PAYMENT_LINE}</p>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-ob]').forEach((form) => {
    const per = Number(form.dataset.qty) || 100;
    const pack = Number(form.dataset.pack) || 0;
    const box = form.querySelector<HTMLElement>('[data-ob-max]');
    const max = Number(box?.dataset.obMax) || 50;
    const count = form.querySelector<HTMLElement>('[data-ob-count]');
    const units = form.querySelector<HTMLElement>('[data-ob-units]');
    const total = form.querySelector<HTMLElement>('[data-ob-total]');
    const packs = form.querySelector<HTMLInputElement>('[data-ob-packs]');
    let n = 1;
    const set = (v: number) => {
      n = Math.max(1, Math.min(max, v));
      if (count) count.textContent = String(n);
      if (units) units.textContent = (n * per).toLocaleString('en-US');
      if (total) total.textContent = `$${(n * pack).toFixed(2)}`;
      if (packs) packs.value = String(n);
    };
    form.querySelector('[data-ob-minus]')?.addEventListener('click', () => set(n - 1));
    form.querySelector('[data-ob-plus]')?.addEventListener('click', () => set(n + 1));
    form.addEventListener('submit', () => {
      const slug = (form.elements.namedItem('add') as HTMLInputElement | HTMLSelectElement | null)?.value;
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      w.gtag?.('event', 'add_to_cart', { currency: 'USD', value: n * pack, items: [{ item_id: slug, quantity: n }] });
    });
  });
</script>

<style>
  .ob {
    display: grid;
    background: var(--ink);
    color: #fff;
  }
  @media (min-width: 60em) {
    .ob {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ob__photo img {
    width: 100%;
    height: 100%;
    max-height: 640px;
    object-fit: cover;
  }
  .ob__panel {
    padding: clamp(44px, 5vw, 72px) var(--gut);
    max-width: 720px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ob h2 {
    color: #fff;
  }
  .ob__price {
    color: var(--cobalt-light);
    white-space: nowrap;
  }
  .ob__panel > p {
    margin-block-start: 14px;
    color: #c4d1e0;
    font-size: 17px;
  }
  .ob__panel > p.ob__line {
    color: #fff;
    font: 700 1.25rem/1.4 var(--font-display);
  }
  .ob__panel a {
    color: var(--cobalt-light);
  }
  .ob__spec {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    border-block-start: 1px solid rgb(255 255 255 / 0.16);
  }
  .ob__spec li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-block-end: 1px solid rgb(255 255 255 / 0.16);
    color: #e7eef7;
  }
  .ob__spec span,
  .ob__spec label {
    width: 110px;
    flex: none;
    color: #93a6bd;
  }
  .ob__select {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 1.5px solid rgb(255 255 255 / 0.35);
    border-radius: 10px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 16px;
  }
  .ob__select option {
    color: #0b1b2b;
  }
  .ob__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-block-start: 28px;
  }
  .ob__stepper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid rgb(255 255 255 / 0.35);
    border-radius: 10px;
    overflow: hidden;
  }
  .ob__stepper button {
    width: 46px;
    height: 50px;
    background: transparent;
    border: 0;
    color: #fff;
    font-size: 22px;
  }
  .ob__stepper output {
    min-width: 44px;
    text-align: center;
    font: 700 18px/1 var(--font-display);
  }
  .ob__units {
    color: #c4d1e0;
  }
  .ob__units span {
    color: #fff;
    font-weight: 700;
  }
  .ob__ship {
    margin-block-start: 22px;
    color: #c4d1e0;
  }
</style>
