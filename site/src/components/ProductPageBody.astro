---
import { withExtras, extraFaqs, extraHeading } from '../lib/page-faqs';
/**
 * Product page body. Rendered by the root [slug] route when the slug resolves
 * to a product. Owns its own <BaseLayout> so each page type controls its own
 * head, schema graph, and Open Graph image.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductGallery from './ProductGallery.astro';
import PriceNote from './PriceNote.astro';
import SpecTable from './SpecTable.astro';
import FaqAccordion from './FaqAccordion.astro';
import RelatedProducts from './RelatedProducts.astro';
import QuoteFormShort from './QuoteFormShort.astro';
import DesignYourBox from './DesignYourBox.astro';
import InquiryForm from './InquiryForm.astro';
import { getProduct } from '../data/products';
import type { ProductContent } from '../data/product-content';
import { business } from '../data/business';
import { reviewsForProduct, aggregateFor } from '../data/reviews';
import {
  graph,
  webPage,
  breadcrumbs as breadcrumbSchema,
  product as productSchema,
  faqPage,
  type Crumb,
} from '../lib/schema';


interface Props {
  content: ProductContent;
}

const { content } = Astro.props;
const record = getProduct(content.slug);
const url = `/${content.slug}/`;

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: record.name, url },
];

const price = business.startingPricePerPiece.value;

// Reviews for this product, and the rating computed from them. Both are empty
// until real reviews exist in src/data/reviews.ts, at which point they render
// on the page AND appear in schema together.
const productReviews = reviewsForProduct(content.slug);
const rating = aggregateFor(productReviews);

/**
 * Resolve the real emitted URLs for the gallery images so JSON-LD and the
 * Open Graph tag point at files that actually exist. Astro writes optimized,
 * content-hashed assets, so the source filename is not the delivered URL.
 */
// '!**/._*' keeps macOS AppleDouble sidecars (exFAT drive) out of the glob.
const imageModules = import.meta.glob<{ default: ImageMetadata }>([
  '../assets/products/**/*.png',
  '!**/._*',
]);

const schemaImages = await Promise.all(
  content.imageAlts.slice(0, 4).map(async (entry) => {
    const load = imageModules[`../assets/products/${content.slug}/${entry.file}`];
    const optimized = await getImage({
      src: (await load()).default,
      width: 1200,
      format: 'webp',
    });
    return optimized.src;
  })
);

const schema = graph(
  webPage({ url, name: content.h1, description: content.metaDescription, dateModified: content.updated }),
  breadcrumbSchema(crumbs),
  productSchema({
    name: record.name,
    slug: url,
    description: content.summary,
    images: schemaImages,
    priceFrom: { amount: price.amount, currency: price.currency },
    aggregateRating: rating,
    reviews: productReviews,
  }),
  faqPage(withExtras(Astro.url.pathname, content.faqs))
);
---

<BaseLayout
  url={url}
  title={content.metaTitle}
  description={content.metaDescription}
  ogType="product"
  ogImage={schemaImages[0]}
  ogImageAlt={content.imageAlts[0].alt}
  modified={content.updated}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />

  {/* ── Showcase: photo gallery + summary + primary CTA ──────────────── */}
  <section class="pp-top">
    <div class="pp-top__media">
      <ProductGallery slug={content.slug} imageAlts={content.imageAlts} productName={record.name} />
    </div>

    <div class="pp-top__body">
      <h1>{content.h1}</h1>
      <p class="pp-top__summary">{content.summary}</p>

      <div class="pp-top__actions">
        <a class="btn btn-solid btn-lg" href="/request-a-quote/">Request a quote</a>
        <a class="btn btn-line btn-lg" href="/sample-request/">Request a sample</a>
        <a class="pp-top__design" href="#design">Design your display box</a>
      </div>

      <ul class="pp-top__facts">
        <li>Free dieline drawn for your product</li>
        <li>Custom sizes — the box is built around your unit</li>
        <li>Shipped to businesses across all 50 states</li>
      </ul>
    </div>
  </section>

  {/* ── Quick inquiry ────────────────────────────────────────────────── */}
  <section class="band--tight wrap pp-ask">
    <InquiryForm context={record.name} contextSlug={content.slug} formType="product-inquiry" variant="compact" />
  </section>

  {/* ── Uses and industries ──────────────────────────────────────────── */}
  <section class="pp-uses">
    <div class="pp-uses__card">
      <h2>What these displays are used for</h2>
      <ul class="tick-list">
        {content.uses.map((use) => <li>{use}</li>)}
      </ul>
    </div>
    <div class="pp-uses__card">
      <h2>Who orders them</h2>
      <ul class="tick-list">
        {content.industries.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  {/* ── Body sections + pricing panel ───────────────────────────────── */}
  <section class="band wrap">
    <div class="page-cols">
      <div class="page-cols__main">
        {
          content.sections.map((section) => (
            <section class="copy-block">
              <h2>{section.heading}</h2>
              {section.body.map((p) => (
                <p>{p}</p>
              ))}
              {section.points && (
                <ul class="tick-list">
                  {section.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
              {section.link && (
                <p class="copy-block__link">
                  {section.link.text} <a href={section.link.href}>{section.link.anchor}</a>.
                </p>
              )}
            </section>
          ))
        }
      </div>

      <aside class="page-cols__side">
        <PriceNote />
      </aside>
    </div>
  </section>

  {/* ── Specifications ───────────────────────────────────────────────── */}
  <section class="band band--mist wrap pp-spec">
    <div class="pp-spec__head">
      <h2>Specifications</h2>
      <p>
        These are the options available for this style. The values set per job are marked as such
        rather than given a figure that would not hold for every order.
      </p>
    </div>
    <div class="pp-spec__table">
      <SpecTable specs={content.specs} productName={record.name} />
    </div>
  </section>

  <DesignYourBox productName={record.name} productSlug={content.slug} id={`dyb-${content.slug}`} />

  <section class="band wrap">
    <FaqAccordion
      faqs={withExtras(Astro.url.pathname, content.faqs)}
      heading={`${record.name} — questions we get asked`}
      intro="Answers specific to this style. For ordering, artwork, and shipping questions that apply across the range, see the general FAQ."
    />
  </section>

  {
    productReviews.length > 0 && (
      <section class="band band--mist wrap">
        <h2>What customers said about this style</h2>
        {rating && (
          <p class="rv-sum">
            <strong>{rating.ratingValue} out of 5</strong> from {rating.reviewCount}{' '}
            {rating.reviewCount === 1 ? 'review' : 'reviews'}
          </p>
        )}
        <ul class="rv-list">
          {productReviews.map((r) => (
            <li class="rv">
              {r.rating && (
                <p class="rv__stars" aria-label={`Rated ${r.rating} out of 5`}>
                  <span aria-hidden="true">
                    {'★'.repeat(r.rating)}
                    {'☆'.repeat(5 - r.rating)}
                  </span>
                </p>
              )}
              <blockquote class="rv__body">{r.body}</blockquote>
              <p class="rv__by">
                {r.author}
                {r.organization ? `, ${r.organization}` : ''} ·{' '}
                <time datetime={r.date}>{r.date}</time>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── Related ──────────────────────────────────────────────────────── */}
  <section class="band band--mist wrap">
    <RelatedProducts slugs={content.related} />
  </section>

  {/* ── Final quote form ─────────────────────────────────────────────── */}
  <section class="band wrap">
    <QuoteFormShort productName={record.name} productSlug={content.slug} />
  </section>
</BaseLayout>

<style>
  .pp-top {
    display: grid;
    gap: 32px;
    align-items: start;
    padding: 32px var(--gut) 56px;
    background: linear-gradient(180deg, var(--mist) 0%, var(--mist) 70%, #fff 100%);
  }

  @media (min-width: 64em) {
    .pp-top {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: clamp(40px, 5vw, 80px);
      padding-block: 40px 72px;
    }
    .pp-top__body {
      position: sticky;
      top: 104px;
      padding-block-start: 12px;
    }
  }

  .pp-top__summary {
    margin-block-start: 18px;
    color: var(--ink-2);
    font-size: 1.125rem;
    max-width: 60ch;
  }

  .pp-top__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-block: 28px;
  }

  .pp-top__design {
    font-weight: 600;
  }

  .pp-top__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: #fff;
  }

  .pp-top__facts li {
    padding: 13px 18px 13px 46px;
    position: relative;
    font-weight: 600;
    color: var(--ink);
  }

  .pp-top__facts li + li {
    border-block-start: 1px solid var(--rule);
  }

  .pp-top__facts li::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 50%;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--cobalt)
      url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m6.5 12.5 3.5 3.5 7.5-8" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>')
      center/11px no-repeat;
  }

  .pp-uses {
    display: grid;
    gap: 20px;
    padding: 0 var(--gut) var(--band-y-tight);
  }

  @media (min-width: 52em) {
    .pp-uses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pp-uses__card {
    padding: clamp(24px, 3vw, 36px);
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }

  .pp-uses__card h2 {
    font-size: var(--t-xl);
  }

  .pp-spec {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 66em) {
    .pp-spec {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.5fr);
      gap: 64px;
      align-items: start;
    }
  }

  .pp-spec__head p {
    margin-block-start: 12px;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .rv-sum {
    margin-block: 12px 24px;
    color: var(--muted);
  }

  .rv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }

  .rv {
    padding: 22px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }

  .rv__stars {
    color: var(--cobalt);
    letter-spacing: 0.1em;
  }

  .rv__body {
    margin: 12px 0;
    color: var(--ink-2);
  }

  .rv__by {
    font-size: var(--t-sm);
    color: var(--muted);
  }
</style>
