---
/**
 * Product gallery.
 *
 * The first image is the LCP candidate: it is eager, high priority, and never
 * lazy-loaded. Every other image is lazy with async decoding. All images carry
 * intrinsic width/height so no thumbnail or main frame can shift layout.
 *
 * Thumbnail switching is progressive enhancement — with JavaScript off the
 * thumbnails are anchors to the full images and the main image still renders.
 */
import { Image, Picture, getImage } from 'astro:assets';
import type { ImageAlt } from '../data/product-content';

interface Props {
  slug: string;
  imageAlts: ImageAlt[];
  productName: string;
}
const { slug, imageAlts, productName } = Astro.props;

// Eagerly collect this product's images from the assets directory.
// Lazy glob: only the images this product actually renders are imported, so
// unused source PNGs are never emitted into the build output.
// The '!**/._*' negation excludes macOS AppleDouble sidecar files, which the
// exFAT drive creates next to every image — they match *.png but are not PNGs.
const modules = import.meta.glob<{ default: ImageMetadata }>([
  '../assets/products/**/*.png',
  '!**/._*',
]);

const images = await Promise.all(
  imageAlts.map(async (entry) => {
    const key = `../assets/products/${slug}/${entry.file}`;
    const load = modules[key];
    if (!load) {
      throw new Error(
        `ProductGallery: "${entry.file}" is listed in imageAlts for "${slug}" but is not in src/assets/products/${slug}/. Run \`npm run images\`.`
      );
    }
    return { src: (await load()).default, alt: entry.alt };
  })
);

// The main frame is a <picture> with avif/webp <source> elements, so switching
// images means swapping those source srcsets — not just the <img> fallback,
// which the browser ignores whenever a <source> matches. Pre-generate the same
// widths/formats the primary <Picture> uses for every image, so each thumbnail
// carries a full-resolution set to swap in rather than its own 72px source.
const MAIN_WIDTHS = [480, 720, 960];
const MAIN_SIZES = '(min-width: 64em) 32rem, (min-width: 40em) 50vw, 92vw';

const built = await Promise.all(
  images.map(async ({ src }) => {
    const [avif, webp] = await Promise.all([
      getImage({ src, widths: MAIN_WIDTHS, format: 'avif' }),
      getImage({ src, widths: MAIN_WIDTHS, format: 'webp' }),
    ]);
    return {
      avif: avif.srcSet.attribute,
      webp: webp.srcSet.attribute,
      src: webp.src,
      srcset: webp.srcSet.attribute,
    };
  })
);

const [primary, ...rest] = images;
---

<div class="gallery">
  <figure class="gallery__main">
    <Picture
      id={`gallery-main-${slug}`}
      src={primary.src}
      alt={primary.alt}
      widths={MAIN_WIDTHS}
      sizes={MAIN_SIZES}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      pictureAttributes={{ class: 'gallery__picture' }}
      class="gallery__img"
    />
  </figure>

  {
    rest.length > 0 && (
      <ul class="gallery__thumbs" aria-label={`More views of ${productName}`}>
        {images.map((img, i) => (
          <li>
            <button
              type="button"
              class="gallery__thumb"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`Show view ${i + 1} of ${images.length}: ${img.alt}`}
              data-gallery-thumb
              data-index={i}
              data-avif={built[i].avif}
              data-webp={built[i].webp}
              data-src={built[i].src}
              data-srcset={built[i].srcset}
            >
              {/*
                The thumbnail carries its descriptive alt for image SEO. It is
                not announced twice: the button's aria-label overrides its
                content in the accessible-name computation.
              */}
              <Image
                src={img.src}
                alt={img.alt}
                widths={[72, 144]}
                sizes="72px"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  // Thumbnail switching. The main frame is a <picture>, so the browser renders
  // whichever <source> matches (avif, then webp) and ignores the <img> src
  // unless no source matches. Switching therefore has to rewrite the <source>
  // srcsets too — updating the <img> alone changes nothing on-screen. Each
  // thumbnail carries the full-resolution avif/webp/fallback sets as data
  // attributes, generated at build time to match the primary image exactly.
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('.gallery__img');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
    if (!main || !thumbs.length) return;

    const picture = main.closest('picture');
    const avifSource = picture?.querySelector<HTMLSourceElement>('source[type="image/avif"]');
    const webpSource = picture?.querySelector<HTMLSourceElement>('source[type="image/webp"]');

    /* Warm the full-resolution views so a thumbnail click swaps instantly
       rather than starting a download. Low priority, at idle, so the first
       paint keeps the network to itself. */
    const warm = (thumb: HTMLButtonElement) => {
      if (thumb.dataset.warmed) return;
      thumb.dataset.warmed = '1';
      const image = new Image();
      image.fetchPriority = 'low';
      image.sizes = main.sizes || '';
      // Prefer the same format the browser is already showing.
      const set = (avifSource?.srcset && thumb.dataset.avif) || thumb.dataset.webp || thumb.dataset.srcset;
      if (set) image.srcset = set;
      if (thumb.dataset.src) image.src = thumb.dataset.src;
    };

    const warmAll = () => thumbs.forEach(warm);
    if ('requestIdleCallback' in window) {
      (window as unknown as { requestIdleCallback: (cb: () => void, opts?: object) => void })
        .requestIdleCallback(warmAll, { timeout: 2500 });
    } else {
      window.addEventListener('load', () => setTimeout(warmAll, 1200), { once: true });
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('pointerenter', () => warm(thumb), { once: true });
      thumb.addEventListener('touchstart', () => warm(thumb), { once: true, passive: true });
      thumb.addEventListener('click', () => {
        const { avif, webp, src, srcset } = thumb.dataset;
        if (avifSource && avif) avifSource.srcset = avif;
        if (webpSource && webp) webpSource.srcset = webp;
        if (src) main.src = src;
        if (srcset) main.srcset = srcset;

        // Descriptions come from the button's aria-label, since the thumbnail
        // images are decorative and carry no alt text of their own.
        const label = thumb.getAttribute('aria-label') || '';
        main.alt = label.replace(/^Show view \d+ of \d+: /, '') || main.alt;

        thumbs.forEach((t, j) => t.setAttribute('aria-pressed', String(i === j)));
      });
    });
  });
</script>

<style>
  .gallery__main {
    margin: 0;
    background: var(--c-paper-warm);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .gallery__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
  }

  .gallery__thumb {
    display: block;
    width: 72px;
    padding: 0;
    background: var(--c-paper-warm);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .gallery__thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .gallery__thumb:hover {
    border-color: var(--c-ink-500);
  }

  .gallery__thumb[aria-pressed='true'] {
    border-color: var(--c-signal-700);
    box-shadow: inset 0 0 0 1px var(--c-signal-700);
  }
</style>
