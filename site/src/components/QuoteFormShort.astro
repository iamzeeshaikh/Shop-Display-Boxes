---
/**
 * Short product quote form, embedded at the foot of each product page.
 *
 * Posts to the same endpoint as the full form at /request-a-quote/ with a
 * `formType` discriminator. Client-side validation is usability only — the
 * endpoint revalidates everything server-side and is the security boundary.
 *
 * Anti-spam: a honeypot field hidden from sight and from assistive tech, plus
 * a timestamp the endpoint uses to reject submissions completed implausibly
 * fast. Neither replaces the endpoint's rate limiting.
 */
interface Props {
  productName: string;
  productSlug: string;
}
const { productName, productSlug } = Astro.props;
const formId = `quote-${productSlug}`;
---

<section class="quote-short" aria-labelledby={`${formId}-heading`}>
  <div class="quote-short__intro">
    <h2 id={`${formId}-heading`}>Get a price for {productName.toLowerCase()}</h2>
    <p>
      Send your dimensions and quantity and we will come back with a price and a suggested
      structure. If you do not have dimensions yet, send the product itself — we size the box
      around it.
    </p>
    <p class="quote-short__alt">
      Need more fields? Use the <a href="/request-a-quote/">full quote form</a>.
    </p>
  </div>

  <form class="quote-short__form" method="post" action="/api/quote/" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="formType" value="product-quote" />
    <input type="hidden" name="product" value={productSlug} />
    <input type="hidden" name="startedAt" value="" data-started-at />

    {/* Honeypot: hidden from view and from assistive technology. */}
    <div class="hp" aria-hidden="true">
      <label for={`${formId}-company-url`}>Company website</label>
      <input id={`${formId}-company-url`} name="companyUrl" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label for={`${formId}-name`}>Your name <span aria-hidden="true">*</span></label>
      <input id={`${formId}-name`} name="name" type="text" required autocomplete="name" />
    </div>

    <div class="field">
      <label for={`${formId}-email`}>Business email <span aria-hidden="true">*</span></label>
      <input
        id={`${formId}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
      />
    </div>

    <div class="field">
      <label for={`${formId}-phone`}>Phone</label>
      <input id={`${formId}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </div>

    <div class="field field--half">
      <label for={`${formId}-qty`}>Quantity <span aria-hidden="true">*</span></label>
      <input id={`${formId}-qty`} name="quantity" type="number" min="1" required inputmode="numeric" />
    </div>

    <div class="field field--half">
      <label for={`${formId}-unit`}>Units</label>
      <select id={`${formId}-unit`} name="unit">
        <option value="in">Inches</option>
        <option value="mm">Millimeters</option>
        <option value="cm">Centimeters</option>
      </select>
    </div>

    <div class="field">
      <label for={`${formId}-dims`}>Dimensions (length × width × height)</label>
      <input id={`${formId}-dims`} name="dimensions" type="text" placeholder="e.g. 8 × 6 × 10" />
    </div>

    <div class="field">
      <label for={`${formId}-notes`}>Message / instructions</label>
      <textarea id={`${formId}-notes`} name="notes" rows="3"
        placeholder="What are you packing, plus any print, finish or deadline detail."></textarea>
    </div>

    <div class="field">
      <label for={`${formId}-artwork`}>Upload artwork <span class="field__optional">optional</span></label>
      <input
        id={`${formId}-artwork`}
        name="artwork"
        type="file"
        accept=".pdf,.ai,.eps,.psd,.png,.jpg,.jpeg,.zip"
        aria-describedby={`${formId}-artwork-hint`}
      />
      <p class="field__hint" id={`${formId}-artwork-hint`}>PDF, AI, EPS, PSD, PNG, JPG or ZIP.</p>
    </div>

    <div class="field field--consent">
      <input id={`${formId}-consent`} name="consent" type="checkbox" required />
      <label for={`${formId}-consent`}>
        I agree that my details may be used to respond to this enquiry, as described in the
        <a href="/privacy-policy/">privacy policy</a>.
      </label>
    </div>

    <div class="form-status" role="status" aria-live="polite" data-form-status></div>

    <button class="btn btn--primary btn--lg" type="submit">Request a quote</button>
  </form>
</section>

<script>

  /** Build a JSON body from the form, encoding any file as base64. */
  async function jsonBody(form: HTMLFormElement): Promise<Record<string, string>> {
    const data = new FormData(form);
    const payload: Record<string, string> = {};
    data.forEach((value, key) => {
      if (typeof value === 'string') payload[key] = value;
    });
    const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
    const file = fileInput?.files?.[0];
    if (file && file.size > 0) {
      payload.artwork = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result).split(',')[1] ?? '');
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
      payload.artworkName = file.name;
      payload.artworkType = file.type;
    }
    return payload;
  }

  // Progressive enhancement: submit in the background and, on success, send the
  // visitor to the thank-you page rather than navigating to a raw JSON response.
  document.querySelectorAll<HTMLFormElement>('.quote-short__form').forEach((form) => {
    const stamp = form.querySelector<HTMLInputElement>('[data-started-at]');
    if (stamp) stamp.value = String(Date.now());

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }
      if (status) {
        status.textContent = '';
        delete status.dataset.tone;
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: JSON.stringify(await jsonBody(form)),
          headers: { accept: 'application/json', 'content-type': 'application/json' },
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok && data.ok) {
          if (button) button.textContent = 'Sent — redirecting…';
          window.location.assign('/thank-you/');
          return;
        }

        if (status) {
          status.textContent =
            data.message || 'Something went wrong. Please try again or email us directly.';
          status.dataset.tone = 'error';
        }
      } catch {
        if (status) {
          status.textContent = 'We could not send that just now. Please try again in a moment.';
          status.dataset.tone = 'error';
        }
      } finally {
        if (button && button.textContent === 'Sending…') {
          button.disabled = false;
          button.textContent = 'Request a quote';
        }
      }
    });
  });
</script>

<style>
  .quote-short {
    display: grid;
    gap: var(--s-7);
    padding: var(--s-7);
    background: var(--c-ink-900);
    color: var(--c-ink-200);
    border-radius: var(--r-lg);
  }

  @media (min-width: 56em) {
    .quote-short {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--s-9);
      padding: var(--s-9);
    }
  }

  .quote-short :global(h2) {
    color: var(--c-paper);
    margin-block-end: var(--s-4);
  }

  .quote-short__intro p {
    max-width: 42ch;
  }

  .quote-short__alt {
    margin-block-start: var(--s-4);
    font-size: var(--t-sm);
  }

  .quote-short a {
    color: var(--c-kraft-400);
  }

  .quote-short__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .field {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-2);
  }

  .field--half {
    grid-column: span 1;
  }

  .field__optional {
    font-weight: 400;
    opacity: 0.7;
  }

  .field__hint {
    font-size: var(--t-xs, 0.78rem);
    color: var(--c-paper);
    opacity: 0.7;
    margin: 0;
  }

  input[type='file'] {
    padding: var(--s-2);
  }

  label {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--c-paper);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: var(--s-3);
    min-height: 44px;
    background: var(--c-paper);
    color: var(--c-ink-900);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--r-md);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 1px;
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--c-error-700);
    border-width: 2px;
  }

  .field--consent {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--s-3);
  }

  .field--consent input {
    width: 20px;
    height: 20px;
    min-height: 0;
    margin-block-start: 2px;
  }

  .field--consent label {
    font-weight: 400;
    font-size: var(--t-sm);
    color: var(--c-ink-200);
  }

  .field-error {
    font-size: var(--t-sm);
    color: #ffb4b4;
    font-weight: 600;
  }

  .form-status {
    grid-column: 1 / -1;
  }

  .form-status:empty {
    display: none;
  }

  button[type='submit'] {
    grid-column: 1 / -1;
    justify-self: start;
  }

  /* Honeypot — removed from layout and from the accessibility tree. */
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
