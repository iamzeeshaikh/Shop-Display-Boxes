---
/**
 * Site header (Showroom).
 *
 * One row: logo, primary nav, phone, Request a Quote. Every menu is a
 * disclosure — a real <button aria-expanded> controlling a panel — so menus
 * work by click, keyboard and touch; on a mouse they also open on hover, with a
 * short close delay and an invisible bridge so the pointer can travel into the
 * panel. Product, industry and location entries carry photo thumbnails.
 */
import Logo from './Logo.astro';
import { PRIMARY_NAV, PRODUCT_MENU } from '../data/navigation';
import { business, has } from '../data/business';
import { menuThumbnails } from '../lib/menu-thumbs';

const phone = has(business.phone)
  ? (business.phone.value as { e164: string; display: string })
  : null;

const menuThumbs = await menuThumbnails();
---

<header class="sh">
  <div class="sh-row">
    <a class="sh-brand" href="/" aria-label="Shop Display Boxes — home">
      <Logo />
    </a>

    <nav class="sh-nav" aria-label="Primary">
      <ul class="sh-nav__list">
        {
          PRIMARY_NAV.map((item) => {
            if (item.kind === 'link') {
              return (
                <li class="sh-nav__item">
                  <a class="sh-nav__top" href={item.href}>{item.label}</a>
                </li>
              );
            }
            const id = `menu-${item.label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
            const wide = item.kind === 'mega' || item.kind === 'columns';
            return (
              <li class:list={['sh-nav__item', wide && 'sh-nav__item--wide']} data-menu>
                <button class="sh-nav__top" type="button" aria-expanded="false" aria-controls={id}>
                  {item.label}
                  <svg class="sh-nav__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" />
                  </svg>
                </button>

                {item.kind === 'mega' ? (
                  <div class="sh-panel sh-panel--wide" id={id} hidden>
                    <div class="sh-panel__cols">
                      {PRODUCT_MENU.map((col) => (
                        <div class="sh-panel__col">
                          <h2 class="sh-panel__head">{col.heading}</h2>
                          <ul class="sh-thumbs">
                            {col.links.map((l) => (
                              <li>
                                <a href={l.href}>
                                  {menuThumbs[l.href] && (
                                    <img src={menuThumbs[l.href]} alt="" width="44" height="44" loading="lazy" decoding="async" />
                                  )}
                                  <span>{l.label}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      <div class="sh-panel__col sh-panel__aside">
                        <h2 class="sh-panel__head">Not sure which style?</h2>
                        <p>
                          Send your product dimensions and we will suggest a structure and a board
                          weight that carries it.
                        </p>
                        <a class="btn btn-solid" href="/request-a-quote/">Request a quote</a>
                        <a class="sh-panel__link" href="/how-to-choose-retail-display-packaging/">Read the selection guide</a>
                        <a class="sh-panel__link" href="/sample-request/">Request a sample</a>
                      </div>
                    </div>
                  </div>
                ) : item.kind === 'columns' ? (
                  <div class="sh-panel sh-panel--wide" id={id} hidden>
                    <div class="sh-panel__cols sh-panel__cols--loc">
                      {item.columns.map((col) => (
                        <div class="sh-panel__col">
                          <h2 class="sh-panel__head">{col.heading}</h2>
                          <ul class="sh-thumbs sh-thumbs--two">
                            {col.links.map((l) => (
                              <li>
                                <a href={l.href}>
                                  {menuThumbs[l.href] && (
                                    <img src={menuThumbs[l.href]} alt="" width="40" height="40" loading="lazy" decoding="async" />
                                  )}
                                  <span>{l.label}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      <div class="sh-panel__col sh-panel__aside">
                        <h2 class="sh-panel__head">Shipping nationwide</h2>
                        <p>
                          Orders ship free to businesses across the US, and to the UK, Canada and Australia. The pages above cover the
                          markets we are asked about most.
                        </p>
                        <a class="sh-panel__link" href={item.overview.href}>{item.overview.label}</a>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="sh-panel sh-panel--drop" id={id} hidden>
                    <ul class:list={['sh-thumbs', item.links.length > 8 && 'sh-thumbs--two']}>
                      {item.links.map((l) => (
                        <li>
                          <a href={l.href}>
                            {menuThumbs[l.href] && (
                              <img src={menuThumbs[l.href]} alt="" width="40" height="40" loading="lazy" decoding="async" />
                            )}
                            <span>{l.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    {
      phone && (
        <a class="sh-phone" href={`tel:${phone.e164}`} data-track="phone-click" aria-label={`Call ${phone.display}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor" />
          </svg>
          <span>{phone.display}</span>
        </a>
      )
    }

    <a class="btn btn-solid sh-quote" href="/request-a-quote/">Request a Quote</a>

    <button class="sh-burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-mobile-toggle>
      <span class="sr-only">Menu</span>
      <span class="sh-burger__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="sh-drawer" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      <ul class="sh-drawer__list">
        <li><a href="/custom-display-boxes/">Custom display boxes</a></li>
        {
          PRIMARY_NAV.map((item) => {
            if (item.kind === 'link') {
              return (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              );
            }
            const links =
              item.kind === 'mega'
                ? PRODUCT_MENU.flatMap((c) => c.links)
                : item.kind === 'columns'
                  ? [...item.columns.flatMap((c) => c.links), item.overview]
                  : item.links;
            const id = `m-${item.label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
            return (
              <li class="sh-drawer__group">
                <button type="button" aria-expanded="false" aria-controls={id} data-mobile-sub>
                  {item.label}
                  <span class="sh-drawer__plus" aria-hidden="true"></span>
                </button>
                <ul id={id} hidden>
                  {links.map((l) => (
                    <li>
                      <a href={l.href}>
                        {menuThumbs[l.href] && (
                          <img src={menuThumbs[l.href]} alt="" width="36" height="36" loading="lazy" decoding="async" />
                        )}
                        <span>{l.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
        <li><a href="/sample-request/">Request a sample</a></li>
      </ul>
      {
        phone && (
          <a class="sh-drawer__phone" href={`tel:${phone.e164}`} data-track="phone-click">
            Call {phone.display}
          </a>
        )
      }
      <a class="btn btn-solid btn-lg sh-drawer__cta" href="/request-a-quote/">Request a Quote</a>
    </nav>
  </div>
</header>

<script>
  // Disclosure menus. Click/keyboard everywhere; hover preview on a mouse,
  // with a short close delay so the pointer can reach the panel.
  const mq = window.matchMedia('(min-width: 62em)');
  const timers = new WeakMap<Element, number>();

  function setOpen(li: Element, open: boolean) {
    const btn = li.querySelector<HTMLButtonElement>('button[aria-expanded]');
    const panel = li.querySelector<HTMLElement>('[id]');
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  }

  function closeAll(except?: Element) {
    document.querySelectorAll<HTMLElement>('[data-menu]').forEach((li) => {
      if (li !== except) setOpen(li, false);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('button[aria-expanded]');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(li);
      setOpen(li, !open);
    });

    li.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        setOpen(li, false);
        btn.focus();
      }
    });

    li.addEventListener('pointerenter', (e) => {
      if (!mq.matches || (e as PointerEvent).pointerType !== 'mouse') return;
      window.clearTimeout(timers.get(li));
      closeAll(li);
      setOpen(li, true);
    });
    li.addEventListener('pointerleave', (e) => {
      if (!mq.matches || (e as PointerEvent).pointerType !== 'mouse') return;
      timers.set(li, window.setTimeout(() => setOpen(li, false), 300));
    });
  });

  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (!(t instanceof Element) || !t.closest('[data-menu]')) closeAll();
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const drawer = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  document.querySelectorAll<HTMLButtonElement>('[data-mobile-sub]').forEach((btn) => {
    const id = btn.getAttribute('aria-controls');
    const list = id ? document.getElementById(id) : null;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if (list) list.hidden = open;
    });
  });
</script>

<style>
  .sh {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: #fff;
    border-block-end: 1px solid var(--rule);
  }

  .sh-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 76px;
    padding-inline: var(--gut);
  }

  .sh-brand {
    text-decoration: none;
    flex: none;
  }

  .sh-nav {
    display: none;
    flex: 1;
    min-width: 0;
    align-self: stretch;
  }

  .sh-nav__list {
    display: flex;
    justify-content: center;
    gap: 2px;
    height: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sh-nav__item {
    position: relative;
    display: flex;
  }

  .sh-nav__item--wide {
    position: static;
  }

  .sh-nav__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    background: none;
    border: 0;
    font: 600 15px/1 var(--font-sans);
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .sh-nav__top:hover,
  .sh-nav__top[aria-expanded='true'] {
    color: var(--cobalt);
  }

  .sh-nav__top[aria-expanded='true'] {
    box-shadow: inset 0 -2px 0 var(--cobalt);
  }

  .sh-nav__caret {
    transition: transform var(--dur-fast);
  }

  .sh-nav__top[aria-expanded='true'] .sh-nav__caret {
    transform: rotate(180deg);
  }

  /* Panels */
  .sh-panel {
    position: absolute;
    top: 100%;
    z-index: var(--z-menu);
    background: #fff;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-lg);
  }

  .sh-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }

  .sh-panel--wide {
    left: 0;
    right: 0;
    border-inline: 0;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    padding: 26px var(--gut) 30px;
  }

  .sh-panel--drop {
    left: -8px;
    min-width: 290px;
    border-radius: var(--r-lg);
    padding: 12px;
  }

  .sh-panel__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 0.9fr);
    gap: 28px;
  }

  .sh-panel__cols--loc {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.5fr) minmax(0, 1fr);
  }

  .sh-panel__head {
    font: 700 13px/1.3 var(--font-sans);
    letter-spacing: 0;
    color: var(--muted);
    padding-block-end: 10px;
    margin-block-end: 8px;
    border-block-end: 1px solid var(--rule);
  }

  .sh-thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .sh-thumbs--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 8px;
  }

  .sh-panel--drop .sh-thumbs--two {
    min-width: 520px;
  }

  .sh-thumbs a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14.5px;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
  }

  .sh-thumbs a:hover {
    background: var(--mist);
    color: var(--cobalt);
  }

  .sh-thumbs img {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    flex: none;
    background: var(--mist);
  }

  .sh-panel__aside {
    background: var(--mist);
    border-radius: var(--r-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .sh-panel__aside .sh-panel__head {
    color: var(--ink);
    font: 800 17px/1.3 var(--font-display);
    border: 0;
    padding: 0;
    margin: 0;
  }

  .sh-panel__aside p {
    color: var(--muted);
    font-size: 15px;
  }

  .sh-panel__link {
    font-weight: 600;
    font-size: 15px;
  }

  /* Phone + quote */
  .sh-phone {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    margin-inline-start: auto;
  }

  .sh-phone svg {
    color: var(--cobalt);
  }

  .sh-phone:hover {
    color: var(--cobalt);
  }

  .sh-quote {
    flex: none;
  }

  .sh-burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .sh-burger__bars span {
    display: block;
    width: 20px;
    height: 2px;
    margin: 4px 0;
    background: var(--ink);
    border-radius: 2px;
  }

  /* Drawer */
  .sh-drawer {
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    border-block-start: 1px solid var(--rule);
    padding: 8px var(--gut) 28px;
    background: #fff;
  }

  .sh-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sh-drawer__list > li {
    border-block-end: 1px solid var(--rule);
  }

  .sh-drawer__list a,
  .sh-drawer__list button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 0;
    background: none;
    border: 0;
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    text-align: left;
    text-decoration: none;
  }

  .sh-drawer__list button {
    justify-content: space-between;
  }

  .sh-drawer__list ul {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
  }

  .sh-drawer__list ul a {
    padding: 7px 0;
    font-weight: 500;
    font-size: 15px;
  }

  .sh-drawer__list ul img {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    object-fit: cover;
  }

  .sh-drawer__plus {
    position: relative;
    width: 14px;
    height: 14px;
  }

  .sh-drawer__plus::before,
  .sh-drawer__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    background: var(--cobalt);
    transition: transform var(--dur-fast);
  }

  .sh-drawer__plus::after {
    transform: rotate(90deg);
  }

  [aria-expanded='true'] > .sh-drawer__plus::after {
    transform: rotate(0);
  }

  .sh-drawer__phone {
    display: block;
    margin-block: 18px 12px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }

  .sh-drawer__cta {
    width: 100%;
  }

  @media (min-width: 62em) {
    .sh-nav {
      display: block;
    }
    .sh-burger,
    .sh-drawer {
      display: none;
    }
    .sh-phone {
      margin-inline-start: 0;
    }
  }

  @media (min-width: 62em) and (max-width: 82em) {
    .sh-row {
      gap: 14px;
    }
    .sh-nav__top {
      padding: 0 8px;
      font-size: 14.5px;
    }
    .sh-phone span {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .sh-row {
      height: 64px;
      gap: 10px;
    }
    .sh-quote {
      display: none;
    }
    .sh-phone {
      width: 44px;
      height: 44px;
      justify-content: center;
      border: 1px solid var(--rule);
      border-radius: 10px;
    }
    .sh-phone span {
      display: none;
    }
  }
</style>
