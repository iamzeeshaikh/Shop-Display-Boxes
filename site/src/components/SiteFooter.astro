---
/**
 * Site footer (Showroom). Brand + NAP, four link groups, policies. Location
 * links live in the header menu, not here (owner's rule).
 */
import Logo from './Logo.astro';
import { FOOTER_GROUPS, FOOTER_POLICIES } from '../data/navigation';
import { business, site, has } from '../data/business';

const phone = has(business.phone)
  ? (business.phone.value as { e164: string; display: string })
  : null;
const email = has(business.email) ? (business.email.value as string) : null;
const address = has(business.address)
  ? (business.address.value as { streetAddress: string; addressLocality: string; addressRegion: string; postalCode: string })
  : null;
const year = new Date().getFullYear();
---

<footer class="sf">
  <div class="sf-top">
    <div class="sf-brand">
      <a href="/" aria-label={`${site.name} — home`}><Logo inverse /></a>
      <p class="sf-blurb">
        Custom printed display boxes and retail display packaging, produced to order and shipped
        free to the US, UK, Canada and Australia.
      </p>
      <address class="sf-nap">
        {address && (
          <span>
            {address.streetAddress}, {address.addressLocality}, {address.addressRegion} {address.postalCode}
          </span>
        )}
        {
          phone && (
            <a href={`tel:${phone.e164}`} data-track="phone-click">
              {phone.display}
            </a>
          )
        }
        {
          email && (
            <a href={`mailto:${email}`} data-track="email-click">
              {email}
            </a>
          )
        }
      </address>
      <a class="btn btn-solid" href="/request-a-quote/">Request a quote</a>
    </div>
    <nav class="sf-nav" aria-label="Footer">
      {
        FOOTER_GROUPS.map((group) => (
          <div class="sf-col">
            <h2 class="sf-head">{group.heading}</h2>
            <ul>
              {group.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="sf-base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <ul class="sf-policies">
      {
        FOOTER_POLICIES.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .sf {
    background: var(--foot);
    color: #a9b8ca;
    padding: 72px var(--gut) 96px;
    font-size: 15px;
  }

  .sf a {
    color: #d7e1ee;
    text-decoration: none;
  }

  .sf a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .sf-top {
    display: grid;
    gap: 44px;
  }

  @media (min-width: 62em) {
    .sf-top {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 4fr);
      gap: 56px;
    }
  }

  .sf-brand > a:first-child {
    display: inline-block;
  }

  .sf-blurb {
    margin-block: 18px 16px;
    max-width: 36ch;
  }

  .sf-nap {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.6;
    margin-block-end: 20px;
  }

  .sf-nap a {
    font-weight: 600;
  }

  .sf-brand .btn {
    color: #fff;
  }

  .sf-brand .btn:hover {
    text-decoration: none;
  }

  .sf-nav {
    display: grid;
    gap: 32px 24px;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .sf-head {
    font: 700 15px/1.3 var(--font-display);
    color: #fff;
    margin-block-end: 14px;
  }

  .sf-nav ul,
  .sf-policies {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sf-nav li + li {
    margin-block-start: 9px;
  }

  .sf-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-block-start: 48px;
    padding-block-start: 24px;
    border-block-start: 1px solid rgb(255 255 255 / 0.12);
    font-size: 14px;
  }

  .sf-policies {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  @media (max-width: 640px) {
    .sf {
      padding-top: 52px;
    }
    .sf-nav {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
