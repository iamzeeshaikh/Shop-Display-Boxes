---
/**
 * FAQ accordion (Showroom): heading and contact card on the left, questions
 * on the right once the space allows (container query, so it also behaves in
 * narrow reading columns). Every answer is in the HTML; <details> only hides
 * it visually. The FAQPage schema is emitted by the page, from the same list.
 */
import type { Faq } from '../data/product-content';
import { business, has } from '../data/business';

interface Props {
  faqs: Faq[];
  heading?: string;
  intro?: string;
  level?: 2 | 3;
}
const { faqs, heading = 'Frequently asked questions', intro, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const phone = has(business.phone)
  ? (business.phone.value as { e164: string; display: string })
  : null;
const email = has(business.email) ? (business.email.value as string) : null;
---

<section class="qa">
  <div class="qa__grid">
    <div class="qa__side">
      <Heading class="qa__heading">{heading}</Heading>
      {intro && <p class="qa__intro">{intro}</p>}
      <div class="qa__contact">
        {phone && <a class="qa__phone" href={`tel:${phone.e164}`} data-track="phone-click">{phone.display}</a>}
        {email && <a class="qa__mail" href={`mailto:${email}`} data-track="email-click">{email}</a>}
      </div>
    </div>
    <div class="qa__list">
      {
        faqs.map((faq, i) => (
          <details class="qa__item" name="faq" open={i === 0}>
            <summary>{faq.question}</summary>
            <div class="qa__a">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .qa {
    container-type: inline-size;
  }

  .qa__grid {
    display: grid;
    gap: 28px;
  }

  @container (min-width: 860px) {
    .qa__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: 64px;
    }
    .qa__side {
      position: sticky;
      top: 110px;
      align-self: start;
    }
  }

  .qa__intro {
    margin-block-start: 12px;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .qa__contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block-start: 22px;
    padding: 18px 20px;
    border-radius: var(--r-lg);
    background: var(--mist);
    border: 1px solid var(--rule);
  }

  .qa__phone {
    font: 700 18px/1.4 var(--font-display);
    color: var(--ink);
    text-decoration: none;
  }

  .qa__mail {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .qa__list {
    border-block-start: 1px solid var(--rule);
  }

  .qa__item {
    border-block-end: 1px solid var(--rule);
  }

  .qa__item summary {
    list-style: none;
    cursor: pointer;
    position: relative;
    padding: 20px 44px 20px 0;
    font: 700 1.0625rem/1.4 var(--font-display);
    color: var(--ink);
  }

  .qa__item summary::-webkit-details-marker {
    display: none;
  }

  .qa__item summary::after {
    content: '';
    position: absolute;
    right: 8px;
    top: 50%;
    width: 10px;
    height: 10px;
    border: solid var(--cobalt);
    border-width: 0 2px 2px 0;
    transform: translateY(-70%) rotate(45deg);
    transition: transform var(--dur-base);
  }

  .qa__item[open] summary::after {
    transform: translateY(-30%) rotate(-135deg);
  }

  .qa__item summary:hover {
    color: var(--cobalt);
  }

  .qa__a {
    padding: 0 44px 22px 0;
    color: var(--ink-2);
  }
</style>
