---
/**
 * Breadcrumb trail. The same crumb array is passed to the BreadcrumbList
 * schema builder so the two can never disagree.
 */
import type { Crumb } from '../lib/schema';
import { path } from '../lib/urls';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav class="trail" aria-label="Breadcrumb">
  <ol class="wrap">
    {
      crumbs.map((c, i) => (
        <li>
          {i === last ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={path(c.url)}>{c.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .trail {
    background: #fff;
    border-block-end: 1px solid var(--rule);
    font-size: 14px;
  }
  .trail ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
    list-style: none;
    margin: 0;
    padding-block: 12px;
  }
  .trail li {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
  }
  .trail li + li::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-inline: 10px 12px;
    border: solid #9fb2c8;
    border-width: 1.5px 1.5px 0 0;
    transform: rotate(45deg);
  }
  .trail a {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
  }
  .trail a:hover {
    color: var(--cobalt);
    text-decoration: underline;
  }
  .trail [aria-current] {
    color: var(--muted);
  }
</style>
