---
import { withExtras, extraFaqs, extraHeading } from '../lib/page-faqs';
/**
 * Body for every non-product root-level page: commercial, industry, guide,
 * and policy. The `kind` discriminator changes the layout emphasis and the
 * schema type, so a guide does not render identically to a policy page.
 *
 * Layout variants:
 *   commercial — wide sections with a sticky quote panel
 *   industry   — wide sections, product recommendations, FAQ block
 *   guide      — narrow prose column, tables, no sticky panel
 *   policy     — narrow prose column, owner-verification notice where needed
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FaqAccordion from './FaqAccordion.astro';
import RelatedProducts from './RelatedProducts.astro';
import QuotePanel from './QuotePanel.astro';
import InquiryForm from './InquiryForm.astro';
import QuoteFormFull from './QuoteFormFull.astro';
import DesignYourBox from './DesignYourBox.astro';
import { Image } from 'astro:assets';
import { photo, photoOf } from '../lib/photos';
import { INDUSTRY_PHOTOS } from '../data/showroom';
import type { PageContent } from '../data/page-content';
import { allReviews, aggregateFor } from '../data/reviews';
import {
  graph,
  webPage,
  breadcrumbs as breadcrumbSchema,
  faqPage,
  type Crumb,
} from '../lib/schema';
import { absolute } from '../lib/urls';

interface Props {
  content: PageContent;
}
const { content } = Astro.props;
const url = `/${content.slug}/`;

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: content.h1, url },
];

const pageFaqs = withExtras(Astro.url.pathname, content.faqs ?? []);
const schemaType =
  content.slug === 'about-us'
    ? 'AboutPage'
    : content.slug === 'contact-us'
      ? 'ContactPage'
      : 'WebPage';

// Declared before `schema` because the schema graph consumes it.
const reviews = content.showReviews ? allReviews() : [];
const reviewAggregate = aggregateFor(reviews);

const schema = graph(
  webPage({
    url,
    name: content.h1,
    description: content.metaDescription,
    type: schemaType,
    dateModified: content.updated,
  }),
  breadcrumbSchema(crumbs),
  pageFaqs.length ? faqPage(pageFaqs) : null,
  // Review nodes, emitted only for reviews rendered on this page.
  ...reviews.map((r) => ({
    '@type': 'Review',
    itemReviewed: { '@id': absolute('/') + '#organization' },
    author: {
      '@type': 'Person',
      name: r.author,
      ...(r.organization ? { worksFor: { '@type': 'Organization', name: r.organization } } : {}),
    },
    datePublished: r.date,
    reviewBody: r.body,
    ...(typeof r.rating === 'number'
      ? {
          reviewRating: {
            '@type': 'Rating',
            ratingValue: r.rating,
            bestRating: 5,
            worstRating: 1,
          },
        }
      : {}),
  }))
);

const isNarrow = content.kind === 'guide' || content.kind === 'policy';
const showQuoteForm = content.slug === 'request-a-quote';
// The request-a-quote page carries the full form itself, so the sidebar panel
// that merely links back to it would be redundant there.
const showQuotePanel =
  (content.kind === 'commercial' || content.kind === 'industry') && !showQuoteForm;

// Industry and commercial pages open on a full-bleed product photo; guides,
// policies and utility pages get a plain navy title band.
const photoHead = content.kind === 'industry' || content.kind === 'commercial';
const headImage = photoHead
  ? INDUSTRY_PHOTOS[url]
    ? await photoOf(INDUSTRY_PHOTOS[url])
    : await photo(content.relatedProducts?.[0] ?? 'custom-display-boxes', 1)
  : null;

// Design Your Display Box on every industry page and the commercial hubs.
const DESIGN_HUBS = ['display-box-packaging', 'custom-display-box-manufacturer', 'wholesale-display-boxes', 'low-minimum-orders'];
const showDesign = content.kind === 'industry' || DESIGN_HUBS.includes(content.slug);
---

<BaseLayout
  url={url}
  title={content.metaTitle}
  description={content.metaDescription}
  modified={content.updated}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class:list={['ph-head', headImage ? 'ph-head--photo' : 'ph-head--plain']}>
    {
      headImage && (
        <Image
          src={headImage}
          alt=""
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 40em) 55vw, 100vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="ph-head__img"
        />
      )
    }
    <div class="ph-head__copy">
      <h1>{content.h1}</h1>
      <p class="ph-head__intro">{content.intro}</p>
      {
        headImage && (
          <div class="ph-head__actions">
            <a class="btn btn-solid btn-lg" href="/request-a-quote/">Request a quote</a>
            {showDesign && <a class="btn btn-ghost btn-lg" href="#design">Design your display box</a>}
          </div>
        )
      }
      {
        content.awaitingOwnerFacts && (
          <p class="verify-notice" role="note">
            <strong>Pre-launch note:</strong> parts of this policy depend on business details that
            have not yet been confirmed by the site owner. Those passages are marked and must be
            completed before this page is published. Nothing on this page has been invented to fill
            a gap.
          </p>
        )
      }
    </div>
  </section>

  {
    showQuoteForm && (
      <section class="band--tight wrap">
        <QuoteFormFull />
      </section>
    )
  }

  <section class="band wrap">
    <div class={showQuotePanel ? 'page-cols' : isNarrow ? 'read-col' : ''}>
      <div class={isNarrow ? 'prose' : 'page-cols__main'}>
        {
          content.sections.map((section) => (
            <section class="copy-block">
              <h2>{section.heading}</h2>
              {section.body.map((p) => (
                <p>{p}</p>
              ))}
              {section.points && (
                <ul class="tick-list">
                  {section.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
              {section.link && (
                <p class="copy-block__link">
                  {section.link.text} <a href={section.link.href}>{section.link.anchor}</a>.
                </p>
              )}
            </section>
          ))
        }

        {
          content.tables?.map((table) => (
            <div class="tbl-block">
              <div class="tbl-scroll">
                <table>
                  <caption>{table.caption}</caption>
                  <thead>
                    <tr>
                      {table.headers.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map((row) => (
                      <tr>
                        {row.map((cell, i) =>
                          i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {table.note && <p class="tbl-note">{table.note}</p>}
            </div>
          ))
        }
      </div>

      {
        showQuotePanel && (
          <aside class="page-cols__side">
            <QuotePanel />
          </aside>
        )
      }
    </div>
  </section>

  {
    reviews.length > 0 && (
      <section class="band band--mist wrap">
        <h2>What customers have said</h2>
        {reviewAggregate && (
          <p class="rv-sum">
            <strong>{reviewAggregate.ratingValue} out of 5</strong> from{' '}
            {reviewAggregate.reviewCount} rated{' '}
            {reviewAggregate.reviewCount === 1 ? 'review' : 'reviews'}
          </p>
        )}
        <ul class="rv-list">
          {reviews.map((r) => (
            <li class="rv">
              {r.rating && (
                <p class="rv__stars" aria-label={`Rated ${r.rating} out of 5`}>
                  <span aria-hidden="true">
                    {'★'.repeat(r.rating)}
                    {'☆'.repeat(5 - r.rating)}
                  </span>
                </p>
              )}
              <blockquote class="rv__body">{r.body}</blockquote>
              <p class="rv__by">
                {r.author}
                {r.organization ? `, ${r.organization}` : ''} ·{' '}
                <time datetime={r.date}>{r.date}</time>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    content.relatedProducts && content.relatedProducts.length > 0 && (
      <section class="band band--mist wrap">
        <RelatedProducts slugs={content.relatedProducts} heading="Display packaging for this application" />
      </section>
    )
  }

  {showDesign && <DesignYourBox id={`dyb-${content.slug}`} />}

  {
    pageFaqs.length > 0 && (
      <section class="band wrap">
        <FaqAccordion faqs={pageFaqs} heading={content.faqs?.length ? "Frequently asked questions" : extraHeading(Astro.url.pathname)} />
      </section>
    )
  }

  {
    content.relatedPages && content.relatedPages.length > 0 && (
      <section class="band--tight wrap rl">
        <h2 class="rl__h">Related reading</h2>
        <ul class="rl__list">
          {content.relatedPages.map((p) => (
            <li>
              <a href={p.href}>{p.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    content.kind === 'industry' && (
      <section class="band--tight wrap">
        <InquiryForm context={content.h1} contextSlug={content.slug} formType="industry-inquiry" />
      </section>
    )
  }

  {
    content.cta && (
      <section class="band wrap">
        <div class="cta-strip">
          <div>
            <h2>{content.cta.heading}</h2>
            <p>{content.cta.body}</p>
          </div>
          <a class="btn btn-solid btn-lg" href={content.cta.buttonHref ?? '/request-a-quote/'}>
            {content.cta.buttonLabel ?? 'Request a quote'}
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Page head */
  .ph-head {
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }

  .ph-head__copy {
    position: relative;
    z-index: 1;
    padding: clamp(40px, 5vw, 72px) var(--gut);
    max-width: calc(820px + 2 * var(--gut));
  }

  .ph-head h1 {
    color: #fff;
  }

  .ph-head__intro {
    margin-block-start: 18px;
    color: #d3deea;
    font-size: 1.125rem;
    max-width: 66ch;
  }

  .ph-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 28px;
  }

  .ph-head--photo {
    min-height: clamp(420px, 36vw, 540px);
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, #34506a, #1d3047);
  }

  .ph-head--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(9 20 36 / 0.92) 0%, rgb(9 20 36 / 0.78) 38%, rgb(9 20 36 / 0.18) 68%, rgb(9 20 36 / 0) 82%);
  }

  .ph-head__img {
    position: absolute;
    right: 0;
    top: 0;
    width: 58%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 26%);
    mask-image: linear-gradient(90deg, transparent 0, #000 26%);
  }

  .ph-head--photo .ph-head__copy {
    z-index: 2;
  }

  .ph-head--plain .ph-head__copy {
    padding-block: clamp(40px, 4.5vw, 64px);
  }

  .verify-notice {
    margin-block-start: 24px;
    padding: 14px 18px;
    background: var(--c-warn-100);
    color: var(--ink);
    border-radius: 10px;
    font-size: 15px;
    max-width: 68ch;
  }

  .read-col {
    max-width: var(--w-read);
    margin-inline: auto;
  }

  .tbl-block {
    margin-block-start: 48px;
  }

  .tbl-note {
    margin-block-start: 12px;
    font-size: 14px;
    color: var(--muted);
    max-width: 70ch;
  }

  .rl__h {
    margin-block-end: 16px;
  }

  .rl__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .rl__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 100%;
    padding: 16px 18px;
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .rl__list a::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border: solid var(--cobalt);
    border-width: 2px 2px 0 0;
    transform: rotate(45deg);
  }

  .rl__list a:hover {
    border-color: var(--cobalt);
    color: var(--cobalt);
  }

  .rv-sum {
    margin-block: 12px 24px;
    color: var(--muted);
  }

  .rv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .rv {
    padding: 22px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }

  .rv__stars {
    color: var(--cobalt);
    letter-spacing: 0.1em;
  }

  .rv__body {
    margin: 12px 0;
    color: var(--ink-2);
  }

  .rv__by {
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .cta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(28px, 4vw, 48px);
    background: var(--ink);
    color: #c4d1e0;
    border-radius: var(--r-lg);
  }

  .cta-strip h2 {
    color: #fff;
    margin-block-end: 10px;
  }

  .cta-strip p {
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .ph-head--photo {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      background: var(--ink);
    }
    .ph-head--photo::after {
      display: none;
    }
    .ph-head__img {
      position: relative;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      -webkit-mask-image: linear-gradient(0deg, transparent 0, #000 30%);
      mask-image: linear-gradient(0deg, transparent 0, #000 30%);
    }
    .ph-head--photo .ph-head__copy {
      margin-block-start: -40px;
      padding-block-start: 0;
    }
    .ph-head__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
